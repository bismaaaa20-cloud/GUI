		TextWrapped = true,
		Text = tostring(o.Title or "Notifikasi"),
		LayoutOrder = 1,
		Parent = body,
	})
	if o.Content then
		New("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Font = FONT.Regular,
			TextSize = 12,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			Text = tostring(o.Content),
			LayoutOrder = 2,
			Parent = body,
		})
	end

	-- Muncul & hilang dengan fade halus
	local labels = {}
	for _, d in ipairs(body:GetChildren()) do
		if d:IsA("TextLabel") then
			table.insert(labels, d)
			d.TextTransparency = 1
		end
	end
	card.BackgroundTransparency = 1
	Tween(card, 0.22, { BackgroundTransparency = 0.05 })
	for _, l in ipairs(labels) do
		Tween(l, 0.22, { TextTransparency = 0 })
	end
	local duration = tonumber(o.Duration) or 4
	if duration ~= duration or duration == math.huge or duration == -math.huge then duration = 4 end
	duration = math.clamp(duration, 0.5, 30)
	task.delay(duration, function()
		if not (card and card.Parent) then
			return
		end
		Tween(card, 0.25, { BackgroundTransparency = 1 })
		for _, l in ipairs(labels) do
			if l.Parent then
				Tween(l, 0.25, { TextTransparency = 1 })
			end
		end
		task.delay(0.27, function()
			if card and card.Parent then
				card:Destroy()
			end
		end)
	end)
end

local function safeConfigName(name)
	local clean = tostring(name or "default"):gsub("[^%w_%-]", "_")
	if clean == "" then
		clean = "default"
	end
	return clean
end

function Window:SaveConfig(name)
	if typeof(writefile) ~= "function" then
		return false, "executor tidak mendukung writefile"
	end
	local ok, err = pcall(function()
		if typeof(isfolder) == "function" and typeof(makefolder) == "function" then
			local checkOk, exists = pcall(isfolder, self._folder)
			if checkOk and not exists then makefolder(self._folder) end
		end
		writefile(self._folder .. "/" .. safeConfigName(name) .. ".json", HttpService:JSONEncode(self.Flags))
	end)
	if not ok then return false, tostring(err) end
	return true
end

function Window:LoadConfig(name)
	if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then
		return false, "executor tidak mendukung readfile/isfile"
	end
	local path = self._folder .. "/" .. safeConfigName(name) .. ".json"
	local checkOk, exists = pcall(isfile, path)
	if not checkOk then return false, "gagal memeriksa file config" end
	if not exists then return false, "file config tidak ditemukan" end
	local ok, data = pcall(function()
		local raw = readfile(path)
		if type(raw) ~= "string" then error("data config bukan teks") end
		return HttpService:JSONDecode(raw)
	end)
	if not ok or type(data) ~= "table" then return false, "file config rusak" end
	local applied = 0
	for flag, value in pairs(data) do
		local setter = self._setters[flag]
		if setter then
			local appliedOk = pcall(setter, value)
			if appliedOk then applied += 1 end
		end
	end
	return true, applied
end

-- Daftar nama config yang tersimpan. Membutuhkan listfiles dari executor.
function Window:ListConfigs()
	if typeof(listfiles) ~= "function" then
		return false, "executor tidak mendukung listfiles"
	end
	local ok, files = pcall(listfiles, self._folder)
	if not ok or type(files) ~= "table" then
		return false, "gagal membaca folder config"
	end
	local names = {}
	for _, path in ipairs(files) do
		local name = tostring(path):match("([^/\\\\]+)%.json$")
		if name then
			table.insert(names, name)
		end
	end
	table.sort(names)
	return names
end

-- Hapus satu config berdasarkan nama (tanpa ekstensi).
function Window:DeleteConfig(name)
	if typeof(delfile) ~= "function" then
		return false, "executor tidak mendukung delfile"
	end
	local path = self._folder .. "/" .. safeConfigName(name) .. ".json"
	if typeof(isfile) == "function" then
		local checkOk, exists = pcall(isfile, path)
		if not checkOk then return false, "gagal memeriksa file config" end
		if not exists then return false, "file config tidak ditemukan" end
	end
	local ok, err = pcall(delfile, path)
	if not ok then return false, tostring(err) end
	return true
end

function Window:_select(tab)
	if self._closePopup then
		self._closePopup()
	end
	local changed = self._activeTab ~= tab
	local activeT = math.max(self._fieldT - 0.1, 0.05)
	for _, t in ipairs(self._tabs) do
		local active = (t == tab)
		t.Page.Visible = active
		Tween(t.Button, 0.15, { BackgroundTransparency = active and activeT or 1 })
		t._indicator.Visible = active
		if t._rgbEntry then
			t._rgbEntry.active = active
			self:_syncRGB(t._rgbEntry)
		end
		t._label.TextColor3 = active and Theme.Text or Theme.SubText
		t._badgeGrad.Enabled = active
		t._badge.BackgroundColor3 = active and Color3.new(1, 1, 1) or Theme.Secondary
