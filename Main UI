                TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Text = tostring(o.Name or "Progress"),
                Parent = row,
        })
        local valueLabel = New("TextLabel", {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -14, 0, 7),
                Size = UDim2.fromOffset(100, 20),
                BackgroundTransparency = 1,
                Font = FONT.Bold,
                TextSize = 12,
                TextColor3 = Theme.Cyan,
                TextXAlignment = Enum.TextXAlignment.Right,
                Text = "",
                Parent = row,
        })
        local bar = New("Frame", {
                Position = UDim2.fromOffset(14, 35),
                Size = UDim2.new(1, -28, 0, 8),
                BackgroundColor3 = Theme.Secondary,
                BorderSizePixel = 0,
                Parent = row,
        }, { Corner(0, 1) })
        local fill = New("Frame", {
                Size = UDim2.fromScale(0, 1),
                BackgroundColor3 = Theme.Blue,
                BorderSizePixel = 0,
                Parent = bar,
        }, { Corner(0, 1) })
        local value = min
        local obj = {}
        function obj:Set(nextValue, silent)
                local n = math.clamp(finite(nextValue, min), min, max)
                value = n
                local ratio = span > 0 and math.clamp((n - min) / span, 0, 1) or 0
                Tween(fill, 0.16, { Size = UDim2.fromScale(ratio, 1) })
                valueLabel.Text = tostring(n) .. suffix
                window:_flag(o.Flag, value)
                if not silent then SafeCall(o.Callback, value) end
        end
        function obj:Get()
                return value
        end
        obj:Set(o.Default ~= nil and o.Default or min, true)
        if o.Flag then
			window:_registerFlag(o.Flag, function(v) obj:Set(v, true) end, function(v)
				if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then return false, "harus angka" end
				return true, v
			end)
		end
        return obj
end

