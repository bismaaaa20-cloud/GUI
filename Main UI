	function Window:SetFlag(flag, value)
		local setter = self._setters[flag]
		if not setter then return false, "flag tidak terdaftar" end
		local v = value
		local validator = self._validators[flag]
		if validator then
			local ran, ok, res = pcall(validator, value)
			if not ran or not ok then return false, tostring(res or "nilai ditolak") end
			v = res
		end
		local ok, err = pcall(setter, v)
		if not ok then return false, tostring(err) end
		return true
	end

	function Window:Log(text, level)
		self._log = self._log or {}
		table.insert(self._log, string.format("[%s] %s", string.upper(tostring(level or "info")), tostring(text)))
		while #self._log > 60 do table.remove(self._log, 1) end
		if self._logView then
			self._logView:SetContent(table.concat(self._log, "\n", math.max(1, #self._log - 9)))
		end
	end

	function Window:_probeFPS()
		if self._probing then return end
		self._probing = true
		task.spawn(function()
			task.wait(3)
			local samples = {}
			for _ = 1, 3 do
				local frames, t0 = 0, os.clock()
				local conn = RunService.Heartbeat:Connect(function() frames += 1 end)
				task.wait(1)
				conn:Disconnect()
				table.insert(samples, frames / math.max(os.clock() - t0, 0.1))
			end
			self._probing = false
			if not self.Gui then return end
			table.sort(samples)
			local fps = samples[2]
			self.FPS = fps
			if self._perfMode == "Auto" then
				local low = fps < 24
				if low ~= self._low then self:_applyPerf(low) end
				if low then
					self:Notify({ Title = "Mode hemat aktif", Content = string.format("FPS rendah (%d). Efek berat dimatikan.", math.floor(fps)), Type = "warn" })
				end
			end
		end)
	end

	--// ===== CreateWindow dibungkus (probe FPS, ikon menempel, judul unik) =====
	local baseCreate = Library.CreateWindow
	function Library:CreateWindow(opts)
		local o = {}
		for k, v in pairs(opts or {}) do o[k] = v end
		local mode = tostring(o.Performance or Library.Performance)
		if mode == "Auto" then o.Performance = "High" end
		if o.KeepExisting then
			local base, n = tostring(o.Title or "XevoraHub"), 0
			for _, w in ipairs(Library.Windows) do
				if w.Title:sub(1, #base) == base then n += 1 end
			end
			if n > 0 then o.Title = base .. " #" .. (n + 1) end
		end
		local win = baseCreate(self, o)
		if not win then return nil end
		win._panelT = math.clamp(o.PanelTransparency or Library.PanelTransparency, 0, 0.7)
		if mode == "Auto" then
			win._perfMode = "Auto"
			win:_probeFPS()
		end
		local btn = o.SnapIcon ~= false and win.Gui and win.Gui:FindFirstChild("ToggleIcon")
		if btn then
			btn.InputBegan:Connect(function(input)
				if not IsPress(input) then return end
				local startPos = btn.AbsolutePosition
				local conn
				conn = input.Changed:Connect(function()
					if input.UserInputState ~= Enum.UserInputState.End then return end
					conn:Disconnect()
					local p, sz = btn.AbsolutePosition, btn.AbsoluteSize
					if (p - startPos).Magnitude < 8 then return end
					local cam = workspace.CurrentCamera
					local vp = cam and cam.ViewportSize or Vector2.new(800, 400)
					local x = (p.X + sz.X / 2 < vp.X / 2) and 8 or (vp.X - sz.X - 8)
					local y = math.clamp(p.Y, 8, vp.Y - sz.Y - 8)
					Tween(btn, 0.2, { Position = UDim2.fromOffset(x, y) })
				end)
			end)
		end
		return win
	end

	--// ===== Notifikasi bertipe, batas tumpukan, anti-duplikat =====
	local KINDS = { info = true, success = true, warn = true, error = true }
	function Window:Notify(o)
		if not self.Gui or not self._notifyHolder or not self._notifyHolder.Parent then return end
		o = type(o) == "table" and o or { Title = tostring(o) }
		local kind = KINDS[o.Type] and o.Type or "info"
		local title = tostring(o.Title or "Notifikasi")
		local content = o.Content ~= nil and tostring(o.Content) or nil
		self:Log(content and (title .. ": " .. content) or title, kind)
		local now, key = os.clock(), kind .. "|" .. title .. "|" .. tostring(content)
		self._notifySeen = self._notifySeen or {}
		if o.Dedupe ~= false then
			if self._notifySeen[key] and now - self._notifySeen[key] < 1.5 then return end
			self._notifySeen[key] = now
		end
		for k, t in pairs(self._notifySeen) do
			if now - t > 10 then self._notifySeen[k] = nil end
		end
		self._notifyCards = self._notifyCards or {}
		while #self._notifyCards >= 5 do
			local first = table.remove(self._notifyCards, 1)
			if first and first.Parent then first:Destroy() end
		end
		local accent = kind == "success" and Color3.fromHex("#5BD99A")
			or kind == "warn" and Color3.fromHex("#F2C94C")
			or kind == "error" and Theme.Red or Theme.Blue
		self._notifyOrder += 1
		local card = New("Frame", {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Card,
			BorderSizePixel = 0, LayoutOrder = self._notifyOrder, Parent = self._notifyHolder,
		}, { Corner(12), Stroke(Theme.Border, 1, 0) })
		table.insert(self._notifyCards, card)
		New("Frame", {
			Size = UDim2.new(0, 3, 1, -16), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = accent,
			BorderSizePixel = 0, Parent = card,
		}, { Corner(2) })
		local body = New("Frame", {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = card,
		}, { Pad(24, 11, 14, 11), New("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }) })
		local labels = {}
		local function line(text, size, font, color, order)
			table.insert(labels, New("TextLabel", {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
				Font = font, TextSize = size, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Left,
				TextWrapped = true, TextTransparency = 1, Text = text, LayoutOrder = order, Parent = body,
			}))
		end
		line(title, 14, FONT.Semi, Theme.Text, 1)
		if content then line(content, 12, FONT.Regular, Theme.SubText, 2) end
		card.BackgroundTransparency = 1
		Tween(card, 0.22, { BackgroundTransparency = 0.05 })
		for _, l in ipairs(labels) do Tween(l, 0.22, { TextTransparency = 0 }) end
		local duration = tonumber(o.Duration) or 4
		if duration ~= duration or duration == math.huge or duration == -math.huge then duration = 4 end
		duration = math.clamp(duration, 0.5, 30)
		task.delay(duration, function()
			local i = table.find(self._notifyCards, card)
			if i then table.remove(self._notifyCards, i) end
			if not (card and card.Parent) then return end
			Tween(card, 0.25, { BackgroundTransparency = 1 })
			for _, l in ipairs(labels) do
				if l.Parent then Tween(l, 0.25, { TextTransparency = 1 }) end
			end
			task.delay(0.27, function()
				if card and card.Parent then card:Destroy() end
			end)
		end)
	end

