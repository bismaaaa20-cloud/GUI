	function Tab:AddSubTabs(names)
		local win, n = self.Window, #names
		if n == 0 then return {} end
		local base = self._order
		local host = self._container or self.Page
		local key = "sub_" .. self.Name .. base
		local cur = math.clamp(tonumber(win:_load(key, 1)) or 1, 1, n)
		local bar = New("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, LayoutOrder = base, Parent = host },
			{ New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
		self._order = base + 2
		local chips, pages, out = {}, {}, {}
		local function paint()
			for i, c in ipairs(chips) do
				local on = i == cur
				c.BackgroundColor3 = on and Theme.Blue or Theme.Secondary
				c.BackgroundTransparency = on and 0.05 or win._fieldT
				c.TextColor3 = on and Theme.Background or Theme.Text
				pages[i].Visible = on
			end
		end
		for i, nm in ipairs(names) do
			local c = New("TextButton", {
				Size = UDim2.new(1 / n, -6 * (n - 1) / n, 1, 0), AutoButtonColor = false, Font = FONT.Semi, TextSize = 12,
				TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(nm), LayoutOrder = i, Parent = bar,
			}, { Corner(9), Stroke(Theme.Glow, 1, 0.7) })
			local cont = New("Frame", {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
				LayoutOrder = base + 1, Visible = false, Parent = host,
			}, { New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
			local px = setmetatable({ Window = win, Page = self.Page, Name = self.Name, _items = self._items, _sections = self._sections, _order = 1, _container = cont }, Tab)
			local function sel()
				cur = i
				win:_store(key, i)
				paint()
			end
			px.Select = sel
			win._subs[cont] = sel
			c.MouseButton1Click:Connect(sel)
			chips[i], pages[i], out[i] = c, cont, px
		end
		paint()
		return out
	end

	function Tab:SetColumns(n)
		self._cols = n == 1 and 1 or 2
		self:_reflow(true)
	end

	function Tab:_reflow(force)
		local win, page = self.Window, self.Page
		if not self._cols or not page then return end
		local want = (self._cols == 2 and not win._mobileLayout and win.Root.Size.X.Offset >= 560) and 2 or 1
		if not force and want == self._colsOn and not self._colsDirty then return end
		self._colsDirty, self._colsOn = false, want
		local own, mine = self._colSet or {}, {}
		for _, it in ipairs(self._items) do
			local p = it.Frame.Parent
			if p == page or own[p] then table.insert(mine, it) end
		end
		for _, it in ipairs(mine) do it.Frame.Parent = page end
		for h in pairs(self._hosts or {}) do h:Destroy() end
		self._hosts, self._colSet = {}, {}
		if want == 1 then return end
		local blocks, cur, last = {}, nil, false
		for _, it in ipairs(mine) do
			if not cur or it.Section ~= last then
				cur, last = {}, it.Section
				table.insert(blocks, cur)
			end
			table.insert(cur, it)
		end
		for _, blk in ipairs(blocks) do
			local host = New("Frame", {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
				LayoutOrder = blk[1].Frame.LayoutOrder, Parent = page,
			}, { New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
			self._hosts[host] = true
			local cols, hs = {}, { 0, 0 }
			for i = 1, 2 do
				cols[i] = New("Frame", {
					Size = UDim2.new(0.5, -4, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = i, Parent = host,
				}, { New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
				self._colSet[cols[i]] = true
			end
			for _, it in ipairs(blk) do
				local k = hs[1] <= hs[2] and 1 or 2
				it.Frame.Parent = cols[k]
				local h = it.Frame.Size.Y.Offset
				hs[k] += (h > 0 and h or 56) + 8
			end
		end
	end

	local layoutP2 = Window._layout
	function Window:_layout()
		layoutP2(self)
		for _, t in ipairs(self._tabs) do
			placeBadge(t)
			if t._cols then t:_reflow() end
		end
	end

	local selP2 = Window._select
	function Window:_select(tab)
		local old = self._activeTab
		local oi = old and table.find(self._tabs, old)
		selP2(self, tab)
		local ni = table.find(self._tabs, tab)
		if oi and ni and ni < oi then
			tab.Page.Position = UDim2.fromOffset(-18, 0)
			Tween(tab.Page, 0.2, { Position = UDim2.fromOffset(0, 0) })
		end
	end

	--// Lompat ke komponen
	function Window:Jump(target)
		local item = target
		if type(target) == "string" then
			local e = self:Find(target)
			item = e and e.Item
		end
		if type(item) ~= "table" or not item.Frame then return false end
		local tab
		for _, t in ipairs(self._tabs) do
			if table.find(t._items, item) then tab = t break end
		end
		if not tab then return false end
		if self._searchBox.Text ~= "" then self._searchBox.Text = "" end
		self:_select(tab)
		local a = item.Frame.Parent
		while a and a ~= tab.Page do
			local g = self._groups[a]
			if g then g:SetOpen(true) end
			local s = self._subs[a]
			if s then s() end
			a = a.Parent
		end
		task.delay(0.1, function()
			if not self.Gui or not item.Frame.Parent then return end
			local y = (item.Frame.AbsolutePosition.Y - tab.Page.AbsolutePosition.Y) / self._scale.Scale + tab.Page.CanvasPosition.Y
			tab.Page.CanvasPosition = Vector2.new(0, math.max(0, y - 6))
			local st = item.Frame:FindFirstChildOfClass("UIStroke")
			if st then
				Tween(st, 0.15, { Color = Theme.Blue, Transparency = 0 })
				task.delay(0.9, function()
					if st.Parent then Tween(st, 0.4, { Color = Theme.Glow, Transparency = 0.72 }) end
				end)
			end
		end)
		return true
	end

	function Window:AddCommand(o)
		if type(o) ~= "table" or not o.Name then return end
		table.insert(self._cmds, {
			Name = tostring(o.Name), Desc = o.Desc and tostring(o.Desc), Callback = o.Callback,
			Key = string.lower(tostring(o.Name) .. " " .. tostring(o.Keywords or "")),
		})
	end

	function Window:SetGlobalSearch(on)
		self._gsOn = on and true or false
		self:_store("gs", self._gsOn)
		if self._gs then
			self._gs.Paint()
			self._gs.Show(self._searchBox.Text)
		end
	end

	function Window:_buildSearch()
		local win, sb = self, self._searchBox
		for _, c in ipairs(sb:GetChildren()) do
			if c:IsA("UIPadding") then c.PaddingRight = UDim.new(0, 58) end
		end
		local chip = New("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 53, 0.5, 0), Size = UDim2.fromOffset(50, 20),
			AutoButtonColor = false, Font = FONT.Semi, TextSize = 10, Text = Library:T("all"), ZIndex = 2, Parent = sb,
		}, { Corner(6) })
		local panel = New("Frame", {
			Name = "GlobalResults", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Panel, BackgroundTransparency = 0.04,
			BorderSizePixel = 0, Visible = false, ZIndex = 20, Parent = self._content,
		}, { Corner(10) })
		local list = New("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Blue, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = panel,
		}, { New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }), Pad(0, 0, 6, 8) })
		local res = {}

		local function paint()
			chip.BackgroundColor3 = win._gsOn and Theme.Blue or Theme.Secondary
			chip.TextColor3 = win._gsOn and Theme.Background or Theme.SubText
		end

		local function show(q)
			for _, c in ipairs(list:GetChildren()) do
				if c:IsA("GuiObject") then c:Destroy() end
			end
			res = {}
			if q == "" or (q:sub(1, 1) ~= ">" and not win._gsOn) then
				panel.Visible = false
				return
			end
			if q:sub(1, 1) == ">" then
				local k = q:sub(2):lower():gsub("^%s+", "")
				for _, c in ipairs(win._cmds) do
					if k == "" or c.Key:find(k, 1, true) then
						table.insert(res, { Title = c.Name, Sub = c.Desc or Library:T("cmdSub"), Run = c.Callback })
					end
				end
			else
				local k = q:lower()
				for _, t in ipairs(win._tabs) do
					if t.Name:lower():find(k, 1, true) then
						table.insert(res, { Title = t.Name, Sub = Library:T("tabSub"), Run = function() win:_select(t) end })
					end
					if not t._noReg then
						for _, it in ipairs(t._items) do
							local hay = it.IsGroup and string.lower(it.Disp or "") or it.Text
							if hay and hay ~= "" and hay:find(k, 1, true) then
								local e = it.Key and win._reg and win._reg[it.Key]
								table.insert(res, { Title = e and e.Name or it.Disp or hay, Sub = t.Name, Run = function() win:Jump(it) end })
							end
						end
					end
				end
			end
			if #res == 0 then
				New("TextLabel", {
					Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, Font = FONT.Medium, TextSize = 13,
					TextColor3 = Theme.SubText, TextWrapped = true, Text = Library:T("empty", q), Parent = list,
				})
			end
			for i = 1, math.min(#res, 30) do
				local r = res[i]
				local b = New("TextButton", {
					Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = Theme.Card, BackgroundTransparency = win._cardT,
					AutoButtonColor = false, Text = "", LayoutOrder = i, Parent = list,
				}, { Corner(10), Stroke(Theme.Glow, 1, 0.72) })
				for _, v in ipairs({ { r.Title, 5, 20, FONT.Semi, 13, Theme.Text }, { r.Sub, 25, 16, FONT.Regular, 11, Theme.SubText } }) do
					New("TextLabel", {
						BackgroundTransparency = 1, Position = UDim2.fromOffset(14, v[2]), Size = UDim2.new(1, -28, 0, v[3]),
						Font = v[4], TextSize = v[5], TextColor3 = v[6], TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(v[1] or ""), Parent = b,
					})
				end
				b.MouseButton1Click:Connect(function()
					sb.Text = ""
					SafeCall(r.Run)
				end)
			end
			list.CanvasPosition = Vector2.zero
			panel.Visible = true
		end

		local token = 0
		self:_track(sb:GetPropertyChangedSignal("Text"):Connect(function()
			token += 1
			local m, q = token, sb.Text
			if q == "" then return show(q) end
			task.delay(0.12, function()
				if m == token and win.Gui then show(sb.Text) end
			end)
		end))
		self:_track(sb.FocusLost:Connect(function(enter)
			local r = res[1]
			if enter and panel.Visible and r then
				sb.Text = ""
				SafeCall(r.Run)
			end
		end))
		chip.MouseButton1Click:Connect(function() win:SetGlobalSearch(not win._gsOn) end)
		self._gs = { Panel = panel, Show = show, Paint = paint }
		paint()
	end

	function Window:_buildSwipe()
		local start
		self:_track(UserInputService.InputBegan:Connect(function(i)
			if i.UserInputType ~= Enum.UserInputType.Touch or not self._visible or self.SwipeTabs == false then return end
			if self._closePopup or self._confirming or self._gs.Panel.Visible then return end
			local p = Vector2.new(i.Position.X, i.Position.Y + GuiService:GetGuiInset().Y)
			local ap, as = self._content.AbsolutePosition, self._content.AbsoluteSize
			if p.X < ap.X or p.Y < ap.Y or p.X > ap.X + as.X or p.Y > ap.Y + as.Y then return end
			start = { input = i, p = i.Position, t = os.clock(), cancel = false }
		end))
		self:_track(UserInputService.InputChanged:Connect(function(i)
			if start and i == start.input and self._activeTab and not self._activeTab.Page.ScrollingEnabled then
				start.cancel = true
			end
		end))
		self:_track(UserInputService.InputEnded:Connect(function(i)
			local s = start
			if not s or i ~= s.input then return end
			start = nil
			if s.cancel then return end
			local d = i.Position - s.p
			if os.clock() - s.t > 0.6 or math.abs(d.X) < 90 or math.abs(d.X) < 2.2 * math.abs(d.Y) then return end
			local idx = table.find(self._tabs, self._activeTab)
			local nxt = idx and self._tabs[d.X < 0 and idx + 1 or idx - 1]
			if nxt then self:_select(nxt) end
		end))
	end

	local createP2 = Library.CreateWindow
	function Library:CreateWindow(opts)
		local win = createP2(self, opts)
		if not win then return nil end
		win._cmds, win._groups, win._subs = {}, {}, {}
		win._gsOn = win:_load("gs", true) ~= false
		win:_buildSearch()
		win:_buildSwipe()

		local function B(name, fn, kw) win:AddCommand({ Name = name, Callback = fn, Keywords = kw }) end
		local names = {}
		for n in pairs(Library.Presets or {}) do table.insert(names, n) end
		table.sort(names)
		for _, n in ipairs(names) do
			B("Tema: " .. n, function() Library:SetTheme(n) end, "tema theme warna")
		end		B("Simpan config", function()
			local ok, e = win:SaveConfig("default")
			win:Notify({ Title = ok and "Config disimpan" or "Gagal", Content = ok and "default" or tostring(e), Type = ok and "success" or "error" })
		end, "save")
		B("Muat config", function()
			local ok, a = win:LoadConfig("default")
			win:Notify({ Title = ok and "Config dimuat" or "Gagal", Content = ok and (tostring(a) .. " pengaturan") or tostring(a), Type = ok and "success" or "error" })
		end, "load")
		B("Sembunyikan UI", function() win:Toggle(false) end, "hide tutup")
		B("Sidebar: ganti mode", function()
			win:SetSidebar(({ full = "rail", rail = "hidden", hidden = "full" })[win._sbMode or "full"])
		end, "rail")
		B("Kunci/buka window", function() win:SetLocked(not win._locked) end, "lock")
		for code, nm in pairs({ id = "Indonesia", en = "English" }) do
			B("Bahasa: " .. nm, function()
				Library.Lang = code
				win:_store("lang", code)
			end, "language")
		end

		win:Every(1, function()
			local cnt = {}
			for _, e in ipairs(win._regList or {}) do
				if (e.Kind == "toggle" or e.Kind == "module") and e.Obj and e.Obj.Get and e.Tab then
					local ok, v = pcall(e.Obj.Get, e.Obj)
					if ok and v == true then
						for _, t in ipairs(win._tabs) do
							if t._auto and t._items == e.Tab._items then cnt[t] = (cnt[t] or 0) + 1 end
						end
					end
				end
			end
			for _, t in ipairs(win._tabs) do
				if t._auto then t:SetBadge(cnt[t]) end
			end
		end)
		return win
	end
end
