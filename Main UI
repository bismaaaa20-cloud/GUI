	function Window:_loadUI()
		self._ui = {}
		if not canFS() then return end
		local ok, data = pcall(function()
			local p = self:_uiPath()
			if isfile(p) then return HttpService:JSONDecode(readfile(p)) end
		end)
		if ok and type(data) == "table" then self._ui = data end
	end
	function Window:_store(k, v)
		self._ui = self._ui or {}
		self._ui[k] = v
		self._uiDirty = true
