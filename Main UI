		icon = Library.DefaultIcon
	end
	local iconAsset, iconSource = nil, "none"
	if icon then
		iconAsset, iconSource = ResolveIcon(
			icon,
			opts.IconFile or Library.DefaultIconFile,
			opts.IconURL or Library.DefaultIconURL
