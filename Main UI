function Tab:AddDropdown(o)
	o = o or {}
	local window = self.Window
	local main = window.Main
	local multi = o.Multi == true
	local OPT_H, MAX_VISIBLE = 32, 6

	local options = {}
	for _, v in ipairs(o.Options or {}) do
		table.insert(options, tostring(v))
	end
	local single = nil
	local set = {}
	local open = false
	local entries = {}
	local popup, blocker

	local row = self:_row(44, o.Name or "")
	self:_title(row, o.Name or "Dropdown", nil, -196)

	local valueBox = New("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(172, 30),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		Parent = row,
	}, {
		Corner(8),
		New("UIStroke", { Color = Theme.Stroke, Thickness = 1 }),
	})
	local valueLbl = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -32, 1, 0),
		Font = FONT.Medium,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "None",
		Parent = valueBox,
	})
	local arrow = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -9, 0, 0),
		Size = UDim2.fromOffset(14, 30),
		BackgroundTransparency = 1,
		Font = FONT.Bold,
		TextSize = 12,
		TextColor3 = Theme.SubText,
		Text = "v",
		Parent = valueBox,
	})
	local header = New("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})

	local function currentList()
		local out = {}
		for _, opt in ipairs(options) do
			if set[opt] then
				table.insert(out, opt)
			end
		end
		return out
	end
	local function currentValue()
		if multi then
			return currentList()
		end
		return single
	end
	local function isSelected(opt)
		if multi then
			return set[opt] == true
		end
		return single == opt
	end
	local function updateText()
		if multi then
			local l = currentList()
			valueLbl.Text = #l > 0 and table.concat(l, ", ") or "None"
		else
			valueLbl.Text = single or "None"
		end
	end
	local function paintOptions()
		for opt, e in pairs(entries) do
			local sel = isSelected(opt)
			e.btn.BackgroundTransparency = sel and 0 or 1
			e.lbl.TextColor3 = sel and Theme.Blue or Theme.Text
			if multi then
				e.mark.BackgroundTransparency = sel and 0 or 1
			else
				e.mark.Visible = sel
			end
		end
	end

	local function closePopup()
		open = false
		entries = {}
		if popup then
			popup:Destroy()
			popup = nil
		end
		if blocker then
			blocker:Destroy()
			blocker = nil
		end
		arrow.Text = "v"
		if window._closePopup == closePopup then
			window._closePopup = nil
		end
	end

	local obj = {}
	function obj:Get()
		return currentValue()
	end
	function obj:Set(v, silent)
		set = {}
		single = nil
		if multi then
			for _, k in ipairs(type(v) == "table" and v or {}) do
				set[tostring(k)] = true
			end
		else
			single = v ~= nil and tostring(v) or nil
		end
		updateText()
		paintOptions()
		window:_flag(o.Flag, currentValue())
		if not silent then
			SafeCall(o.Callback, currentValue())
		end
	end

	-- Daftar pilihan tampil sebagai popup melayang di bawah (atau di atas) kotak nilai.
	local function openPopup()
		if window._closePopup then
			window._closePopup()
		end
		open = true
		arrow.Text = "^"
		window._closePopup = closePopup

		local s = window._scale.Scale
		local vbPos, vbSize = valueBox.AbsolutePosition, valueBox.AbsoluteSize
		local mainPos, mainSize = main.AbsolutePosition, main.AbsoluteSize
		local width = vbSize.X / s
		local wantH = math.min(#options, MAX_VISIBLE) * (OPT_H + 3) + 10
		local relX = (vbPos.X - mainPos.X) / s
		local belowY = (vbPos.Y + vbSize.Y + 4 - mainPos.Y) / s
		local aboveBottom = (vbPos.Y - 4 - mainPos.Y) / s
		local spaceBelow = mainSize.Y / s - belowY - 6
		local spaceAbove = aboveBottom - 52
		local h, y
		if spaceBelow >= wantH or spaceBelow >= spaceAbove then
			h = math.min(wantH, math.max(spaceBelow, 60))
			y = belowY
		else
			h = math.min(wantH, math.max(spaceAbove, 60))
			y = aboveBottom - h
		end

		blocker = New("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 40,
			Parent = main,
		})
		blocker.MouseButton1Click:Connect(closePopup)

		popup = New("Frame", {
			Position = UDim2.fromOffset(relX, y),
			Size = UDim2.fromOffset(width, h),
			BackgroundColor3 = Theme.Element,
			BorderSizePixel = 0,
			ZIndex = 50,
			Parent = main,
		}, {
			Corner(8),
			New("UIStroke", { Color = Theme.Blue, Thickness = 1, Transparency = 0.45 }),
		})

		local list = New("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Blue,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Parent = popup,
		}, {
			New("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }),
			Pad(5, 5, 5, 5),
		})

		entries = {}
		for i, opt in ipairs(options) do
			local btn = New("TextButton", {
				Size = UDim2.new(1, 0, 0, OPT_H),
				BackgroundColor3 = Theme.ElementHover,
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				Text = "",
				LayoutOrder = i,
				Parent = list,
			}, { Corner(6) })
			local lbl = New("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.new(1, -44, 1, 0),
				Font = FONT.Medium,
				TextSize = 13,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Text = opt,
				Parent = btn,
			})
			local markChildren = { Gradient(45) }
			if multi then
				table.insert(markChildren, Corner(4))
				table.insert(markChildren, New("UIStroke", { Color = Theme.Stroke, Thickness = 1.5 }))
			else
				table.insert(markChildren, Corner(0, 1))
			end
			local mark = New("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = multi and UDim2.fromOffset(16, 16) or UDim2.fromOffset(8, 8),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = multi and 1 or 0,
				BorderSizePixel = 0,
				Visible = multi,
				Parent = btn,
			}, markChildren)
			entries[opt] = { btn = btn, lbl = lbl, mark = mark }

			btn.MouseEnter:Connect(function()
				if not isSelected(opt) then
					btn.BackgroundTransparency = 0.55
				end
			end)
			btn.MouseLeave:Connect(paintOptions)
			btn.MouseButton1Click:Connect(function()
				if multi then
					set[opt] = (not set[opt]) or nil
				else
					single = opt
				end
				updateText()
				paintOptions()
				window:_flag(o.Flag, currentValue())
				SafeCall(o.Callback, currentValue())
				if not multi then
					closePopup()
				end
			end)
		end
		paintOptions()
	end

	function obj:Refresh(newOptions, keep)
		closePopup()
		options = {}
		for _, v in ipairs(newOptions or {}) do
			table.insert(options, tostring(v))
		end
		if keep then
			local ns = {}
			for k in pairs(set) do
				if table.find(options, k) then
					ns[k] = true
				end
			end
			set = ns
			if single and not table.find(options, single) then
				single = nil
			end
		else
			set = {}
			single = nil
		end
		updateText()
	end

	header.MouseButton1Click:Connect(function()
		if open then
			closePopup()
		else
			openPopup()
		end
	end)

	if o.Default ~= nil then
		obj:Set(o.Default, true)
		task.defer(SafeCall, o.Callback, currentValue())
	end
	if o.Flag then
		window._setters[o.Flag] = function(v)
			obj:Set(v)
		end
	end
	return obj
end

return Library