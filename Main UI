				BackgroundColor3 = Theme.Blue, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = switch,
			}, { Corner(3) })
		else
			switch = New("Frame", {
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(46, 26),
				BackgroundColor3 = Theme.Off, BorderSizePixel = 0, Parent = row,
