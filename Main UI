function Tab:AddSlider(o)
	o = o or {}
	local window = self.Window
	local min, max = o.Min or 0, o.Max or 100
	local inc = o.Increment or 1
	local suffix = o.Suffix or ""
	local span = math.max(max - min, 1e-9)

	local function snap(v)
		v = math.floor(v / inc + 0.5) * inc
		v = math.clamp(v, min, max)
		return tonumber(string.format("%.4f", v))
	end

	local value = snap(o.Default or min)
	local row = self:_row(58, o.Name or "")

	New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 7),
		Size = UDim2.new(1, -120, 0, 18),
		Font = FONT.Medium,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = tostring(o.Name or "Slider"),
		Parent = row,
	})
	local valLbl = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 7),
		Size = UDim2.fromOffset(100, 18),
		BackgroundTransparency = 1,
		Font = FONT.Bold,
		TextSize = 13,
		TextColor3 = Theme.Blue,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Parent = row,
	})
	local bar = New("Frame", {
		Position = UDim2.fromOffset(14, 38),
		Size = UDim2.new(1, -28, 0, 8),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		Parent = row,
	}, {
		Corner(0, 1),
		New("UIStroke", { Color = Theme.Stroke, Thickness = 1, Transparency = 0.4 }),
	})
	local fill = New("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = bar,
	}, { Corner(0, 1), Gradient(0) })
	local knob = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = bar,
	}, { Corner(0, 1), GradStroke(2, 0) })
	local hit = New("TextButton", {
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})

	local obj = {}
	function obj:Set(v, silent)
		value = snap(tonumber(v) or min)
		local rel = (value - min) / span
		fill.Size = UDim2.fromScale(rel, 1)
		knob.Position = UDim2.fromScale(rel, 0.5)
		valLbl.Text = tostring(value) .. suffix
		window:_flag(o.Flag, value)
		if not silent then
			SafeCall(o.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	local dragging = false
	local page = self.Page
	local function fromX(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local new = snap(min + (max - min) * rel)
		if new ~= value then
			obj:Set(new)
		end
	end
	hit.InputBegan:Connect(function(input)
		if IsPress(input) then
			dragging = true
			page.ScrollingEnabled = false
			fromX(input.Position.X)
		end
	end)
	window:_track(UserInputService.InputChanged:Connect(function(input)
		if dragging and IsMove(input) then
			fromX(input.Position.X)
		end
	end))
	window:_track(UserInputService.InputEnded:Connect(function(input)
		if dragging and IsPress(input) then
			dragging = false
			page.ScrollingEnabled = true
		end
	end))

	obj:Set(value, true)
	if o.Flag then
		window._setters[o.Flag] = function(v)
			obj:Set(v)
		end
	end
	task.defer(SafeCall, o.Callback, value)
	return obj
end

