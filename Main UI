	local function Near(a, b)
		return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) < 0.006
	end
	local function ThemeKey(c)
		if typeof(c) ~= "Color3" then return nil end
		for k, v in pairs(Theme) do
