	function Tab:AddChipGrid(o)
		o = o or {}
		local win = self.Window
		local multi = o.Multi == true
		local cols = math.clamp(math.floor(tonumber(o.Columns) or 3), 1, 6)
		local CH = 32
		local options = {}
		for _, v in ipairs(o.Options or {}) do table.insert(options, tostring(v)) end
		local rowsN = math.max(1, math.ceil(#options / cols))
		local row = self:_row(34 + rowsN * (CH + 6) + 4, tostring(o.Name or "") .. " " .. table.concat(options, " "))
		New("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -28, 0, 22),
			Font = FONT.Semi, TextSize = 14, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(o.Name or "Select"), Parent = row,
		})
		local grid = New("Frame", {
			Position = UDim2.fromOffset(10, 34), Size = UDim2.new(1, -20, 0, rowsN * (CH + 6)),
			BackgroundTransparency = 1, Parent = row,
		}, {
			New("UIGridLayout", {
				CellSize = UDim2.new(1 / cols, -(6 * (cols - 1) / cols), 0, CH), CellPadding = UDim2.fromOffset(6, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		local selected, single, chips = {}, nil, {}
		local function value()
			if multi then
				local out = {}
				for _, opt in ipairs(options) do if selected[opt] then table.insert(out, opt) end end
				return out
			end
			return single
		end
		local function paint()
			for opt, b in pairs(chips) do
				local on = multi and selected[opt] == true or (not multi and single == opt)
				b.BackgroundColor3 = on and Theme.Blue or Theme.Secondary
				b.BackgroundTransparency = on and 0.1 or win._fieldT
				b.TextColor3 = on and Theme.Background or Theme.Text
			end
		end
		for i, opt in ipairs(options) do
			local b = New("TextButton", {
				BackgroundColor3 = Theme.Secondary, BackgroundTransparency = win._fieldT, AutoButtonColor = false,
				Font = FONT.Medium, TextSize = 12, TextColor3 = Theme.Text, TextTruncate = Enum.TextTruncate.AtEnd,
				Text = opt, LayoutOrder = i, Parent = grid,
			}, { Corner(8), Stroke(Theme.Glow, 1, 0.7) })
			chips[opt] = b
			b.MouseButton1Click:Connect(function()
				if multi then selected[opt] = (not selected[opt]) or nil else single = opt end
				paint()
				win:_flag(o.Flag, value())
				SafeCall(o.Callback, value())
			end)
		end
		local obj = {}
		function obj:Get() return value() end
		function obj:Set(v, silent)
			selected, single = {}, nil
			if multi then
				for _, k in ipairs(type(v) == "table" and v or {}) do
					if table.find(options, tostring(k)) then selected[tostring(k)] = true end
				end
			elseif v ~= nil and table.find(options, tostring(v)) then
				single = tostring(v)
			end
			paint()
			win:_flag(o.Flag, value())
			if not silent then SafeCall(o.Callback, value()) end
		end
		if o.Flag then
			win:_registerFlag(o.Flag, function(v) obj:Set(v) end, function(v)
				if multi then
					if type(v) ~= "table" then return false, "harus daftar" end
					return true, v
				end
				if type(v) ~= "string" or not table.find(options, v) then return false, "pilihan tidak ada" end
				return true, v
			end)
		end
		if o.Default ~= nil then
			obj:Set(o.Default, true)
			if o.FireOnInit == true then task.defer(SafeCall, o.Callback, value()) end
		else
			paint()
			win:_flag(o.Flag, value())
		end
		return obj
	end

