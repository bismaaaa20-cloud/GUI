function Tab:AddSlider(o)
	o = o or {}
	local window = self.Window
	local min, max = o.Min or 0, o.Max or 100
	local inc = o.Increment or 1
	local suffix = o.Suffix or ""
	local span = math.max(max - min, 1e-9)

	local function snap(v)
		v = math.floor(v / inc + 0.5) * inc
		v = math.clamp(v, min, max)
		return tonumber(string.format("%.4f", v))
	end

	local value = snap(o.Default or min)
	local row = self:_row(64, o.Name or "")

	New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 9),
		Size = UDim2.new(1, -120, 0, 20),
		Font = FONT.Semi,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = tostring(o.Name or "Slider"),
		Parent = row,
	})
	local valLbl = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 9),
		Size = UDim2.fromOffset(100, 20),
		BackgroundTransparency = 1,
		Font = FONT.Bold,
		TextSize = 13,
		TextColor3 = Theme.Cyan,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Parent = row,
	})
	local track = New("Frame", {
		Position = UDim2.fromOffset(14, 44),
		Size = UDim2.new(1, -28, 0, 6),
		BackgroundColor3 = Theme.Secondary,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Parent = row,
	}, { Corner(0, 1) })
	local fill = New("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = track,
	}, { Corner(0, 1), Gradient(0) })
	local thumb = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		Parent = track,
	}, { Corner(0, 1), Stroke(Theme.Blue, 2, 0) })
	-- Area sentuh luas (tinggi 40) supaya mudah digeser di HP
	local hit = New("TextButton", {
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})

	local obj = {}
	function obj:Set(v, silent)
		value = snap(tonumber(v) or min)
		local rel = (value - min) / span
		fill.Size = UDim2.fromScale(rel, 1)
		thumb.Position = UDim2.fromScale(rel, 0.5)
		valLbl.Text = tostring(value) .. suffix
		window:_flag(o.Flag, value)
		if not silent then
			SafeCall(o.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	local dragging = false
	local page = self.Page
	local function fromX(x)
		local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local new = snap(min + (max - min) * rel)
		if new ~= value then
			obj:Set(new)
		end
	end
	local function setThumb(big)
		Tween(thumb, 0.12, { Size = big and UDim2.fromOffset(22, 22) or UDim2.fromOffset(18, 18) })
	end
	hit.InputBegan:Connect(function(input)
		if IsPress(input) then
			dragging = true
			page.ScrollingEnabled = false
			setThumb(true)
			fromX(input.Position.X)
		end
	end)
	window:_track(UserInputService.InputChanged:Connect(function(input)
		if dragging and IsMove(input) then
			fromX(input.Position.X)
		end
	end))
	window:_track(UserInputService.InputEnded:Connect(function(input)
		if dragging and IsPress(input) then
			dragging = false
			page.ScrollingEnabled = true
			setThumb(false)
		end
	end))

	obj:Set(value, true)
	if o.Flag then
		window._setters[o.Flag] = function(v)
			obj:Set(v)
		end
	end
	task.defer(SafeCall, o.Callback, value)
	return obj
end

function Tab:AddInput(o)
	o = o or {}
	local window = self.Window
	local row = self:_row(52, o.Name or "")
	self:_title(row, o.Name or "Input", nil, -190)

	local box = New("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(168, 34),
		BackgroundColor3 = Theme.Secondary,
		BackgroundTransparency = window._fieldT,
		Font = FONT.Regular,
		TextSize = 13,
		TextColor3 = Theme.Text,
		PlaceholderText = tostring(o.Placeholder or "..."),
		PlaceholderColor3 = Theme.SubText,
		Text = "",
		ClearTextOnFocus = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	}, {
		Corner(9),
		Pad(12, 0, 12, 0),
		Stroke(Theme.Glow, 1, 0.65),
	})
	local boxStroke = box:FindFirstChildOfClass("UIStroke")
	box.Focused:Connect(function()
		Tween(boxStroke, 0.15, { Color = Theme.Blue, Transparency = 0 })
	end)

	local value = ""
	local obj = {}
	function obj:Set(v, silent)
		local text = tostring(v == nil and "" or v)
		if o.Numeric then
			local n = tonumber(text)
			if n == nil then
				box.Text = tostring(value)
				return
			end
			value = n
			box.Text = tostring(n)
		else
			value = text
			box.Text = text
		end
		window:_flag(o.Flag, value)
		if not silent then
			SafeCall(o.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	box.FocusLost:Connect(function()
		Tween(boxStroke, 0.15, { Color = Theme.Glow, Transparency = 0.65 })
		obj:Set(box.Text)
	end)

	if o.Default ~= nil then
		obj:Set(o.Default, true)
	end
	if o.Flag then
		window._setters[o.Flag] = function(v)
			obj:Set(v)
		end
	end
	return obj
end

function Tab:AddDropdown(o)
	o = o or {}
	local window = self.Window
	local main = window.Main
	local multi = o.Multi == true
	local OPT_H, MAX_VISIBLE = 38, 5

	local options = {}
	for _, v in ipairs(o.Options or {}) do
		table.insert(options, tostring(v))
	end
	local single = nil
	local set = {}
	local open = false
	local entries = {}
	local popup, blocker

	local row = self:_row(52, o.Name or "")
	self:_title(row, o.Name or "Dropdown", nil, -204)

	local valueBox = New("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(180, 34),
		BackgroundColor3 = Theme.Secondary,
		BackgroundTransparency = window._fieldT,
		BorderSizePixel = 0,
		Parent = row,
	}, {
		Corner(9),
		Stroke(Theme.Glow, 1, 0.65),
	})
	local valueLbl = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -34, 1, 0),
		Font = FONT.Medium,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "None",
		Parent = valueBox,
	})
	local arrow = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 0),
		Size = UDim2.fromOffset(14, 34),
		BackgroundTransparency = 1,
		Font = FONT.Bold,
		TextSize = 12,
		TextColor3 = Theme.SubText,
		Text = "v",
		Parent = valueBox,
	})
	local header = New("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})
	Pressable(header, row, Theme.Card, Theme.Secondary)

	local function currentList()
		local out = {}
		for _, opt in ipairs(options) do
			if set[opt] then
				table.insert(out, opt)
			end
		end
		return out
	end
	local function currentValue()
		if multi then
			return currentList()
		end
		return single
	end
	local function isSelected(opt)
		if multi then
			return set[opt] == true
		end
		return single == opt
	end
	local function updateText()
		if multi then
			local l = currentList()
			valueLbl.Text = #l > 0 and table.concat(l, ", ") or "None"
		else
			valueLbl.Text = single or "None"
		end
	end
	local function paintOptions()
		for opt, e in pairs(entries) do
			local sel = isSelected(opt)
			e.btn.BackgroundTransparency = sel and 0 or 1
			e.lbl.TextColor3 = sel and Theme.Cyan or Theme.Text
			if multi then
				e.mark.BackgroundTransparency = sel and 0 or 1
			else
				e.mark.Visible = sel
			end
		end
	end

	local function closePopup()
		open = false
		entries = {}
		if popup then
			popup:Destroy()
			popup = nil
		end
		if blocker then
			blocker:Destroy()
			blocker = nil
		end
		arrow.Text = "v"
		if window._closePopup == closePopup then
			window._closePopup = nil
		end
	end

	local obj = {}
	function obj:Get()
		return currentValue()
	end
	function obj:Set(v, silent)
		set = {}
		single = nil
		if multi then
			for _, k in ipairs(type(v) == "table" and v or {}) do
				set[tostring(k)] = true
			end
		else
			single = v ~= nil and tostring(v) or nil
		end
		updateText()
		paintOptions()
		window:_flag(o.Flag, currentValue())
		if not silent then
			SafeCall(o.Callback, currentValue())
		end
	end

	-- Daftar pilihan = popup melayang di bawah (atau di atas) kotak nilai, dengan area gulir.
	local function openPopup()
		if window._closePopup then
			window._closePopup()
		end
		open = true
		arrow.Text = "^"
		window._closePopup = closePopup

		local s = window._scale.Scale
		local vbPos, vbSize = valueBox.AbsolutePosition, valueBox.AbsoluteSize
		local mainPos, mainSize = main.AbsolutePosition, main.AbsoluteSize
		local width = vbSize.X / s
		local wantH = math.min(#options, MAX_VISIBLE) * (OPT_H + 4) + 12
		local relX = (vbPos.X - mainPos.X) / s
		local belowY = (vbPos.Y + vbSize.Y + 6 - mainPos.Y) / s
		local aboveBottom = (vbPos.Y - 6 - mainPos.Y) / s
		local spaceBelow = mainSize.Y / s - belowY - 8
		local spaceAbove = aboveBottom - 60
		local h, y
		if spaceBelow >= wantH or spaceBelow >= spaceAbove then
			h = math.min(wantH, math.max(spaceBelow, 70))
			y = belowY
		else
			h = math.min(wantH, math.max(spaceAbove, 70))
			y = aboveBottom - h
		end

		blocker = New("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 40,
			Parent = main,
		})
		blocker.MouseButton1Click:Connect(closePopup)

		popup = New("Frame", {
			Position = UDim2.fromOffset(relX, y),
			Size = UDim2.fromOffset(width, h),
			BackgroundColor3 = Theme.Secondary,
			BackgroundTransparency = 0.06,
			BorderSizePixel = 0,
			ZIndex = 50,
			Parent = main,
		}, {
			Corner(10),
			Stroke(Theme.Blue, 1, 0.5),
		})

		local list = New("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Blue,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Parent = popup,
		}, {
			New("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
			Pad(6, 6, 6, 6),
		})

		entries = {}
		for i, opt in ipairs(options) do
			local btn = New("TextButton", {
				Size = UDim2.new(1, 0, 0, OPT_H),
				BackgroundColor3 = Theme.Hover,
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				Text = "",
				LayoutOrder = i,
				Parent = list,
			}, { Corner(8) })
			local lbl = New("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.new(1, -46, 1, 0),
				Font = FONT.Medium,
				TextSize = 13,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Text = opt,
				Parent = btn,
			})
			local markChildren = { Gradient(45) }
			if multi then
				table.insert(markChildren, Corner(5))
				table.insert(markChildren, Stroke(Theme.Off, 1.5, 0))
			else
				table.insert(markChildren, Corner(0, 1))
			end
			local mark = New("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0),
				Size = multi and UDim2.fromOffset(18, 18) or UDim2.fromOffset(8, 8),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = multi and 1 or 0,
				BorderSizePixel = 0,
				Visible = multi,
				Parent = btn,
			}, markChildren)
			entries[opt] = { btn = btn, lbl = lbl, mark = mark }

			btn.MouseEnter:Connect(function()
				if not isSelected(opt) then
					btn.BackgroundTransparency = 0.5
				end
			end)
			btn.MouseLeave:Connect(paintOptions)
			btn.MouseButton1Click:Connect(function()
				if multi then
					set[opt] = (not set[opt]) or nil
				else
					single = opt
				end
				updateText()
				paintOptions()
				window:_flag(o.Flag, currentValue())
				SafeCall(o.Callback, currentValue())
				if not multi then
					closePopup()
				end
			end)
		end
		paintOptions()
	end

	function obj:Refresh(newOptions, keep)
		closePopup()
		options = {}
		for _, v in ipairs(newOptions or {}) do
			table.insert(options, tostring(v))
		end
		if keep then
			local ns = {}
			for k in pairs(set) do
				if table.find(options, k) then
					ns[k] = true
				end
			end
			set = ns
			if single and not table.find(options, single) then
				single = nil
			end
		else
			set = {}
			single = nil
		end
		updateText()
	end

	header.MouseButton1Click:Connect(function()
		if open then
			closePopup()
		else
			openPopup()
		end
	end)

	if o.Default ~= nil then
		obj:Set(o.Default, true)
		task.defer(SafeCall, o.Callback, currentValue())
	end
	if o.Flag then
		window._setters[o.Flag] = function(v)
			obj:Set(v)
		end
	end
	return obj
end

return Library