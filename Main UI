			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Font = FONT.Regular,
			TextSize = 12,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			Text = tostring(o.Content),
			LayoutOrder = 2,
			Parent = body,
		})
	end

	-- Muncul & hilang dengan fade halus
	local labels = {}
	for _, d in ipairs(body:GetChildren()) do
		if d:IsA("TextLabel") then
			table.insert(labels, d)
			d.TextTransparency = 1
		end
	end
	card.BackgroundTransparency = 1
	Tween(card, 0.22, { BackgroundTransparency = 0.08 })
	for _, l in ipairs(labels) do
		Tween(l, 0.22, { TextTransparency = 0 })
	end
	task.delay(o.Duration or 4, function()
		if not (card and card.Parent) then
			return
		end
		Tween(card, 0.25, { BackgroundTransparency = 1 })
		for _, l in ipairs(labels) do
			if l.Parent then
				Tween(l, 0.25, { TextTransparency = 1 })
			end
		end
		task.delay(0.27, function()
			if card and card.Parent then
				card:Destroy()
			end
		end)
	end)
end

function Window:SaveConfig(name)
	if typeof(writefile) ~= "function" then
		return false, "executor tidak mendukung writefile"
	end
	local ok, err = pcall(function()
		if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(self._folder) then
			makefolder(self._folder)
		end
		writefile(self._folder .. "/" .. tostring(name or "default") .. ".json", HttpService:JSONEncode(self.Flags))
	end)
	return ok, err
end

function Window:LoadConfig(name)
	if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then
		return false, "executor tidak mendukung readfile/isfile"
	end
	local path = self._folder .. "/" .. tostring(name or "default") .. ".json"
	if not isfile(path) then
		return false, "file config tidak ditemukan"
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then
		return false, "file config rusak"
	end
	for flag, value in pairs(data) do
		local setter = self._setters[flag]
		if setter then
			pcall(setter, value)
		end
	end
	return true
end

function Window:_select(tab)
	if self._closePopup then
		self._closePopup()
	end
	local changed = self._activeTab ~= tab
	local activeT = math.max(self._fieldT - 0.15, 0.1)
	for _, t in ipairs(self._tabs) do
		local active = (t == tab)
		t.Page.Visible = active
		Tween(t.Button, 0.15, { BackgroundTransparency = active and activeT or 1 })
		t._indicator.Visible = active
		t._label.TextColor3 = active and Theme.Text or Theme.SubText
		t._badgeGrad.Enabled = active
		t._badge.BackgroundColor3 = active and Color3.new(1, 1, 1) or Theme.Secondary
		t._badgeLbl.TextColor3 = active and Color3.new(1, 1, 1) or Theme.SubText
		if t._icon then
			t._icon.ImageColor3 = active and Color3.new(1, 1, 1) or Theme.SubText
		end
	end
	self._activeTab = tab
	if changed then
		tab.Page.Position = UDim2.fromOffset(18, 0)
		Tween(tab.Page, 0.2, { Position = UDim2.fromOffset(0, 0) })
	end
	tab:_applySearch(self._searchBox.Text)
end

