	--// Ticker
	function Window:Every(sec, fn, always)
		local list = self._tasks
		if not list then
			list = {}
			self._tasks = list
			self:_track(RunService.Heartbeat:Connect(function(dt)
				for i = #list, 1, -1 do
					local t = list[i]
					if t.dead then
						table.remove(list, i)
					elseif self._visible or t.always then
						t.acc += dt
						if t.acc >= (self._low and t.sec * 2 or t.sec) then
							t.acc = 0
							SafeCall(t.fn)
						end
					end
				end
			end))
		end
		local t = { sec = sec, fn = fn, always = always, acc = 0 }
		table.insert(list, t)
		return function() t.dead = true end
	end

	--// Registry
	function Window:_regAdd(key, e)
		self._reg, self._regList = self._reg or {}, self._regList or {}
		local base, n = key, 1
		while self._reg[key] do
			n += 1
			key = base .. "#" .. n
		end
		e.Key = key
		self._reg[key] = e
		table.insert(self._regList, e)
		return e
	end
	function Window:Find(key) return self._reg and self._reg[key] end
	function Window:Each(fn)
		for _, e in ipairs(self._regList or {}) do fn(e) end
	end

	function Library:_decorate(name, kind)
		local base = Tab[name]
		if type(base) ~= "function" or (Library._dec and Library._dec[name]) then return end
		Library._dec = Library._dec or {}
		Library._dec[name] = true
		Tab[name] = function(self, o, ...)
			local n = #self._items
			local obj = base(self, o, ...)
			if type(o) ~= "table" then o = {} end
			local item = self._items[n + 1]
			local def
			if type(obj) == "table" and obj.Get then
				local ok, v = pcall(obj.Get, obj)
				if ok then def = v end
			end
			local e = self.Window:_regAdd(o.Flag or (self.Name .. "/" .. tostring(o.Name or kind)), {
				Kind = kind, Name = tostring(o.Name or kind), Tab = self, Item = item, Obj = obj, Flag = o.Flag, Default = def, Tip = o.Tip,
			})
			if item then item.Key = e.Key end
			return obj
		end
	end
	for name, kind in pairs({ AddToggle = "toggle", AddSlider = "slider", AddDropdown = "dropdown", AddInput = "input", AddKeybind = "keybind", AddButton = "button", AddColorPicker = "color", AddChipGrid = "chips", AddModule = "module" }) do
