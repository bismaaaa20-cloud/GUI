		end
		local last = 0
		h.InputBegan:Connect(function(input)
			if not IsPress(input) then return end
			local now = os.clock()
			if now - last < 0.35 then
				last = 0
				self:ResetSize()
				return
			end
			last = now
			if self._maxed or self._mobileLayout then return end
			local s = self._scale.Scale
			local sx, sy = input.Position.X, input.Position.Y
			local w0, h0, p0 = self.Root.Size.X.Offset, self.Root.Size.Y.Offset, self.Root.Position
			self._uScale, self._uW, self._uH = s, w0, h0
			local conn, endc
			conn = UserInputService.InputChanged:Connect(function(i)
				if not IsMove(i) or not self.Gui then return end
				self._uW, self._uH = w0 + (i.Position.X - sx) / s, h0 + (i.Position.Y - sy) / s
				self:_layout()
				local nw, nh = self.Root.Size.X.Offset, self.Root.Size.Y.Offset
				self.Root.Position = UDim2.new(p0.X.Scale, p0.X.Offset + (nw - w0) * s / 2, p0.Y.Scale, p0.Y.Offset + (nh - h0) * s / 2)
			end)
			endc = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					conn:Disconnect()
					endc:Disconnect()
					self:_store("size", { self._uW, self._uH, self._uScale })
				end
			end)
		end)

		self:_track(RunService.Heartbeat:Connect(function(dt)
			self._fps = (self._fps or 60) * 0.95 + (1 / math.max(dt, 1 / 240)) * 0.05
		end))
	end

	--// Layout
	function Window:_layout()
		local Z = self.Zones
		if not Z or not self.Gui then return baseLayout(self) end
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(800, 400)
		local mobile, maxed = vp.X <= 620, self._maxed == true
		local mult = math.clamp(self._mult or 1, 0.5, 1.5)
		local baseH = (mobile and MOBILE_H or WIN_H) + 26
		local W, H, s
		if self._uW and not mobile and not maxed and MIN_W * (self._uScale or 1) <= vp.X * 0.98 then
			s = self._uScale or 1
			W = math.clamp(self._uW, MIN_W, math.max(MIN_W, vp.X * 0.96 / s))
			H = math.clamp(self._uH or baseH, 300, math.max(300, vp.Y * 0.92 / s))
		else
			local fitH = vp.Y * (maxed and 0.94 or 0.88) / (baseH * mult)
			local fitW = vp.X * (maxed and 0.98 or 0.96) / (MIN_W * mult)
			s = math.clamp(math.min(fitH, fitW, (maxed and 1.4 or 1.15) / mult) * mult, 0.35, 1.8)
			W = mobile and MIN_W or math.clamp(vp.X * (maxed and 0.96 or 0.66) / math.max(s, 0.01), MIN_W, maxed and 960 or MAX_W)
			H = baseH
		end
		self.Root.Size = UDim2.fromOffset(W, H)
		self._targetScale = s
		if self._visible then self._scale.Scale = s end

		local mode = self._sbMode or "full"
		local rail = not mobile and mode == "rail"
		local sbW = mobile and 0 or (mode == "full" and (W < 560 and 148 or 168) or (rail and 76 or 0))
		local bodyBot = H - 36
		local cx, cy, cw
		local sidebar = self._sidebar
		sidebar.Position = UDim2.fromOffset(10, 67)
		if mobile then
			sidebar.Visible = true
			sidebar.Size = UDim2.new(1, -20, 0, 52)
			self._tabList.Position, self._tabList.Size = UDim2.fromOffset(0, 3), UDim2.new(1, 0, 0, 46)
			self._tabLayout.FillDirection = Enum.FillDirection.Horizontal
			self._tabList.ScrollingDirection = Enum.ScrollingDirection.X
			self._tabList.AutomaticCanvasSize = Enum.AutomaticSize.X
			self._profile.Visible = false
			cx, cy, cw = 10, 125, W - 20
		else
			sidebar.Visible = sbW > 0
			sidebar.Size = UDim2.new(0, sbW, 0, bodyBot - 67)
			self._tabList.Position, self._tabList.Size = UDim2.fromOffset(0, 10), UDim2.new(1, 0, 1, -80)
			self._tabLayout.FillDirection = Enum.FillDirection.Vertical
			self._tabList.ScrollingDirection = Enum.ScrollingDirection.Y
			self._tabList.AutomaticCanvasSize = Enum.AutomaticSize.Y
			self._profile.Visible = true
			self._profile.ClipsDescendants = true
			cx = sbW > 0 and (sbW + 20) or 10
			cy, cw = 67, W - cx - 10
		end
		for _, t in ipairs(self._tabs) do
			t.Button.Size = mobile and UDim2.fromOffset(116, 38) or (rail and UDim2.new(1, 0, 0, 58) or UDim2.new(1, 0, 0, 42))
			railTab(t, rail)
		end

		local y, zv = cy, self._zv
		Z.Toolbar.Visible = zv.Toolbar
		if zv.Toolbar then
			Z.Toolbar.Position, Z.Toolbar.Size = UDim2.fromOffset(cx, y), UDim2.fromOffset(cw, 36)
			local sw = mobile and (cw - 12) or math.clamp(cw * 0.45, 150, 250)
			self._searchBox.Size = UDim2.fromOffset(sw, 28)
			Z.Toggle.Visible, Z.Crumb.Visible = not mobile, not mobile
			Z.Crumb.Size = UDim2.new(0, math.max(cw - sw - 56, 40), 1, 0)
			y += 42
		end
		Z.Banner.Visible = zv.Banner
		if zv.Banner then
			Z.Banner.Position, Z.Banner.Size = UDim2.fromOffset(cx, y), UDim2.fromOffset(cw, 36)
			y += 42
		end
		Z.Pin.Visible = zv.Pin
		if zv.Pin then
			Z.Pin.Position, Z.Pin.Size = UDim2.fromOffset(cx, y), UDim2.fromOffset(cw, 34)
			y += 40
		end
		local pw = 0
		if Z.Preview then
			local showP = zv.Preview and not mobile and W >= 640
			Z.Preview.Visible = showP
			if showP then
				pw = 220
				Z.Preview.Position, Z.Preview.Size = UDim2.fromOffset(cx + cw - pw, y), UDim2.fromOffset(pw, bodyBot - y)
				pw += 8
			end
		end
		self._content.Position = UDim2.fromOffset(cx, y)
		self._content.Size = UDim2.fromOffset(cw - pw, math.max(bodyBot - y, 60))

		local showChip = W >= 560
		Z.Chip.Visible = showChip
		for _, c in ipairs(Z.Header:GetChildren()) do
			if c:IsA("TextLabel") and c ~= Z.Chip then
				c.Size = UDim2.new(1, -(c.Position.X.Offset + 136 + (showChip and 108 or 0)), 0, c.Size.Y.Offset)
			end
		end
		self._mobileLayout = mobile
		self._notifyHolder.Size = UDim2.new(0, math.max(150, math.min(270, vp.X - 24)), 1, -24)
		ClampToScreen(self.Root, function() return self._scale.Scale end)
	end

	--// Status bar
	function Window:_snapshot()
		local ok, s = pcall(HttpService.JSONEncode, HttpService, self.Flags)
		return ok and s or nil
	end
	function Window:_isDirty()
		if not self._snap then
			if self._born and os.clock() - self._born > 2 then self._snap = self:_snapshot() end
			return false
		end
		return self:_snapshot() ~= self._snap
	end
	for _, nm in ipairs({ "SaveConfig", "LoadConfig" }) do
		local b = Window[nm]
		Window[nm] = function(self, ...)
			local r = table.pack(b(self, ...))
			if r[1] then self._snap = self:_snapshot() end
			return table.unpack(r, 1, r.n)
		end
	end
	function Window:_statusTick()
		local Z = self.Zones
		if not Z or not self.Gui then return end
		local n = 0
		for _, e in ipairs(self._regList or {}) do
			if (e.Kind == "toggle" or e.Kind == "module") and e.Obj and e.Obj.Get then
				local ok, v = pcall(e.Obj.Get, e.Obj)
				if ok and v == true then n += 1 end
			end
		end
		Z.StLeft.Text = "• " .. Library:T("active", n)
		local ping = pingMs()
		if self._statusMsg and os.clock() < (self._statusUntil or 0) then
			Z.StMid.Text = self._statusMsg
		else
			Z.StMid.Text = string.format("FPS %d%s", math.floor(self._fps or 0), ping and (" · " .. ping .. " ms") or "")
		end
		local dirty = self:_isDirty()
		Z.StRight.Text = (dirty and Library:T("unsaved") or Library:T("saved")) .. (self._locked and (" · " .. Library:T("locked")) or "")
		Z.StRight.TextColor3 = dirty and GOLD or Theme.SubText
		Z.Chip.Text = "v" .. Library.Version .. (ping and (" · " .. ping .. "ms") or "")
	end
	--// API
	function Window:SetStatus(text, secs)
		self._statusMsg, self._statusUntil = tostring(text), os.clock() + (secs or 3)
		self:_statusTick()
	end
	function Window:SetZone(name, on)
		if self._zv and self._zv[name] ~= nil then
			self._zv[name] = on and true or false
			self:_layout()
		end
	end
	function Window:SetSidebar(mode)
		if mode ~= "full" and mode ~= "rail" and mode ~= "hidden" then return false end
		self._sbMode = mode
		self:_store("sb", mode)
		self:_layout()
		return true
	end
	function Window:SetRail(on) return self:SetSidebar(on and "rail" or "full") end
	function Window:SetLocked(on)
		self._locked = on and true or false
		self.Root:SetAttribute("XLocked", self._locked or nil)
		self:_store("locked", self._locked)
		if self.Zones then self:_statusTick() end
	end
	function Window:ResetSize()
		self._uW, self._uH, self._uScale = nil, nil, nil
		self:_store("size", nil)
		self:_layout()
	end
	function Window:SetBanner(o)
		local Z = self.Zones
		if not Z then return end
		local bans = self:_load("bans", nil) or {}
		if type(o) ~= "table" or (o.Id and bans[o.Id]) then
			self._zv.Banner = false
			return self:_layout()
		end
		self._banner = o
		Z.BannerBar.BackgroundColor3 = ({ warn = GOLD, success = GREEN, error = Theme.Red })[o.Kind] or Theme.Blue
		Z.BannerText.Text = tostring(o.Text or "")
		local act = type(o.Action) == "table" and o.Action
		Z.BannerAct.Visible = act ~= nil
		Z.BannerAct.Text = act and tostring(act.Text or "OK") or ""
		Z.BannerX.Visible = o.Dismissible ~= false
		Z.BannerText.Size = UDim2.new(1, act and -126 or -50, 1, 0)
		self._zv.Banner = true
		self:_layout()
	end
	function Window:SetKeyInfo(o)
		o = o or {}
		local lbl
		for _, c in ipairs(self._profile:GetChildren()) do
			if c:IsA("TextLabel") and c.Position.Y.Offset == 26 then lbl = c end
		end
		if not lbl then return end
		local ok = o.Status == nil or tostring(o.Status):lower() == "active"
		local txt = Library:T(ok and "keyOk" or "keyBad")
		if ok and tonumber(o.Expires) then
			local d = math.floor((o.Expires - os.time()) / 86400)
			ok = d >= 0
			txt = ok and Library:T("keyDays", d) or Library:T("keyBad")
		end
		lbl.Text, lbl.TextColor3 = txt, ok and GREEN or Theme.Red
	end

	--// Pembungkus
	local selectP1 = Window._select
	function Window:_select(tab)
		selectP1(self, tab)
		if self.Zones then self.Zones.Crumb.Text = tab.Name end
	end
	local addTabP1 = Window.AddTab
	function Window:AddTab(o)
		local t = addTabP1(self, o)
		self:_layout()
		return t
	end
	local baseSearch = Tab._applySearch
	function Tab:_applySearch(q)
		baseSearch(self, q)
		local any = false
		for _, it in ipairs(self._items) do
			if it.Frame.Visible then any = true break end
		end
		local show = (q or "") ~= "" and not any
		local e = self._empty
		if show and not e then
			local f = New("Frame", { Name = "Empty", Size = UDim2.new(1, 0, 0, 92), BackgroundTransparency = 1, LayoutOrder = 1000000, Visible = false, Parent = self.Page })
			local lbl = New("TextLabel", { Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, Font = FONT.Medium, TextSize = 13, TextColor3 = Theme.SubText, TextWrapped = true, Text = "", Parent = f })
			local b = New("TextButton", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 52), Size = UDim2.fromOffset(150, 30), BackgroundColor3 = Theme.Secondary, AutoButtonColor = false, Font = FONT.Semi, TextSize = 12, TextColor3 = Theme.Text, Text = Library:T("clear"), Parent = f }, { Corner(9) })
			b.MouseButton1Click:Connect(function() self.Window._searchBox.Text = "" end)
			e = { Frame = f, Label = lbl }
			self._empty = e
		end
		if e then
			e.Frame.Visible = show
			if show then e.Label.Text = Library:T("empty", q) end
		end
	end

	local prevCreate = Library.CreateWindow
	function Library:CreateWindow(opts)
		local win = prevCreate(self, opts)
		if not win then return nil end
		win._born = os.clock()
		win._sbMode = (type(opts) == "table" and opts.Rail) and "rail" or win:_load("sb", "full")
		local sz = win:_load("size", nil)
		if type(sz) == "table" and #sz == 3 then win._uW, win._uH, win._uScale = sz[1], sz[2], sz[3] end
		win:_buildZones()
		win:SetLocked(win:_load("locked", false) == true)
		win:Every(1, function() win:_statusTick() end)
		win:_layout()
		win:_statusTick()
		return win
	end
end
