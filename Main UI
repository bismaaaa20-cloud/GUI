	function Window:AddDiagnostics(name)
		local win = self
		local tab = win:AddTab(name or "Diagnostik")
		tab:AddSection("Sistem")
		local info = tab:AddParagraph({ Title = "Executor", Content = "-" })
		local function refresh()
			local r = Library:CheckCompatibility()
			info:SetTitle("Executor: " .. r.Executor)
			info:SetContent(string.format("XevoraUI v%s | FPS: %s\nTidak didukung: %s", r.Version,
				win.FPS and tostring(math.floor(win.FPS)) or "?",
				#r.Unsupported > 0 and table.concat(r.Unsupported, ", ") or "-"))
		end
		refresh()
		tab:AddButton({ Name = "Cek ulang", Text = "Cek", Callback = refresh })
		tab:AddButton({ Name = "Ukur FPS", Text = "Ukur", Callback = function()
			task.spawn(function()
				local frames, t0 = 0, os.clock()
				local conn = RunService.Heartbeat:Connect(function() frames += 1 end)
				task.wait(1.5)
				conn:Disconnect()
				win.FPS = frames / math.max(os.clock() - t0, 0.1)
				if win.Gui then refresh() end
			end)
		end })
		tab:AddSection("Log")
		local view = tab:AddParagraph({ Title = "Log terbaru", Content = "(kosong)" })
		win._logView = view
		tab:AddButton({ Name = "Salin log", Text = "Salin", Callback = function()
			local ok = SetClipboard(table.concat(win._log or {}, "\n"))
			win:Notify({ Title = ok and "Log disalin" or "Clipboard tidak tersedia", Type = ok and "success" or "warn" })
		end })
		tab:AddButton({ Name = "Bersihkan log", Text = "Hapus", Callback = function()
			win._log = {}
			view:SetContent("(kosong)")
		end })
		win:Log("Diagnostik aktif")
		return tab
	end

	Library:SetTheme("Dark Glass")
