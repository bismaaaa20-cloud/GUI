	MakeDraggable = function(handle, target, track, onClick, getScale)
		local dragging, dragStart, startPos, dragInput, moved = false, nil, nil, nil, 0
		track(handle.InputBegan:Connect(function(input)
			if not IsPress(input) or target:GetAttribute("XLocked") then return end
			dragging, moved, dragStart, startPos = true, 0, input.Position, target.Position
			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					conn:Disconnect()
					if onClick and moved < 6 then onClick() end
				end
			end)
		end))
		track(handle.InputChanged:Connect(function(input)
			if IsMove(input) then dragInput = input end
		end))
		track(UserInputService.InputChanged:Connect(function(input)
			if dragging and input == dragInput then
				local d = input.Position - dragStart
				moved = math.max(moved, d.Magnitude)
				local s = getScale and getScale() or 1
				target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X / s, startPos.Y.Scale, startPos.Y.Offset + d.Y / s)
				ClampToScreen(target, getScale)
			end
		end))
	end

