--// ===== Helpers =====

local function New(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function Corner(offset, scale)
	return New("UICorner", { CornerRadius = UDim.new(scale or 0, offset or 0) })
end

local function Pad(l, t, r, b)
	return New("UIPadding", {
		PaddingLeft = UDim.new(0, l),
		PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r),
		PaddingBottom = UDim.new(0, b),
	})
end

-- Gradasi biru -> ungu -> merah (sesuai logo). fade = true membuat ujung kanan memudar.
local function Gradient(rotation, fade)
	return New("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.Blue),
			ColorSequenceKeypoint.new(0.5, Theme.Purple),
			ColorSequenceKeypoint.new(1, Theme.Red),
		}),
		Transparency = fade and NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 0.85),
		}) or NumberSequence.new(0),
		Rotation = rotation or 0,
	})
end

local function GradStroke(thickness, rotation, transparency)
	return New("UIStroke", {
		Color = Color3.new(1, 1, 1),
		Thickness = thickness or 1,
		Transparency = transparency or 0,
	}, { Gradient(rotation or 0) })
end

local function Tween(inst, time, props)
	local tw = TweenService:Create(inst, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function SafeCall(fn, ...)
	if typeof(fn) ~= "function" then
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[MouseUI] error di callback: " .. tostring(err))
	end
end

local function IsPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function IsMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

local function ToAsset(icon)
	if icon == nil then
		return ""
	end
	if type(icon) == "number" then
		return "rbxassetid://" .. icon
	end
	if tostring(icon):match("^%d+$") then
		return "rbxassetid://" .. tostring(icon)
	end
	return tostring(icon)
end

-- Urutan sumber ikon: file lokal -> URL -> ID asset. Mengembalikan (asset, namaSumber).
local function ResolveIcon(icon, file, url)
	if typeof(getcustomasset) == "function" then
		if file and file ~= "" and typeof(isfile) == "function" then
			local ok, res = pcall(function()
				if isfile(file) then
					return getcustomasset(file)
				end
			end)
			if ok and res then
				return res, "file"
			end
		end
		if url and url ~= "" and typeof(writefile) == "function" then
			local ok, res = pcall(function()
				if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder("MouseUI") then
					makefolder("MouseUI")
				end
				local ext = tostring(url):match("%.(%w+)$") or "png"
				local path = "MouseUI/icon." .. ext
				writefile(path, game:HttpGet(url))
				return getcustomasset(path)
			end)
			if ok and res then
				return res, "url"
			end
			warn("[MouseUI] gagal memuat IconURL, mencoba ID asset")
		end
	end
	return ToAsset(icon), "id"
end

local function GetGuiParent()
	if typeof(gethui) == "function" then
		local ok, res = pcall(gethui)
		if ok and res then
			return res
		end
	end
	local ok = pcall(function()
		local probe = Instance.new("Folder")
		probe.Parent = CoreGui
		probe:Destroy()
	end)
	if ok then
		return CoreGui
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

-- Skala otomatis: panel memakai ~62% lebar dan ~82% tinggi layar (seperti hub lain), maksimal 1.25x.
local function GetFit()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(800, 400)
	return math.min(vp.X * 0.62 / WIN_W, vp.Y * 0.82 / WIN_H, 1.25)
end

local function MakeDraggable(handle, target, track, onClick, getScale)
	local dragging, dragStart, startPos, dragInput = false, nil, nil, nil
	local moved = 0
	track(handle.InputBegan:Connect(function(input)
		if IsPress(input) then
			dragging = true
			moved = 0
			dragStart = input.Position
			startPos = target.Position
			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					conn:Disconnect()
					if onClick and moved < 6 then
						onClick()
					end
				end
			end)
		end
	end))
	track(handle.InputChanged:Connect(function(input)
		if IsMove(input) then
			dragInput = input
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and input == dragInput then
			local delta = input.Position - dragStart
			moved = math.max(moved, delta.Magnitude)
			local s = getScale and getScale() or 1
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X / s,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y / s
			)
		end
	end))
end

