	function Window:_retheme(old)
		if not self.Gui then return end
		local map = {}
		for k, oc in pairs(old) do
			local nc = Theme[k]
			if nc ~= oc then table.insert(map, { oc, nc }) end
		end
		if #map == 0 then return end
		local function swap(c)
			for _, m in ipairs(map) do
				if Near(c, m[1]) then return m[2] end
			end
			return c
		end
		local function put(obj, prop)
			local c = obj[prop]
			local n = swap(c)
			if n ~= c then obj[prop] = n end
		end
		for _, d in ipairs(self.Gui:GetDescendants()) do
			if d:IsA("GuiObject") then
				put(d, "BackgroundColor3")
				if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
					put(d, "TextColor3")
					if d:IsA("TextBox") then put(d, "PlaceholderColor3") end
				elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
					put(d, "ImageColor3")
				elseif d:IsA("ScrollingFrame") then
					put(d, "ScrollBarImageColor3")
				end
			elseif d:IsA("UIStroke") then
				put(d, "Color")
			elseif d:IsA("UIGradient") then
				local out, changed = {}, false
				for _, kp in ipairs(d.Color.Keypoints) do
					local n = swap(kp.Value)
					if n ~= kp.Value then changed = true end
					table.insert(out, ColorSequenceKeypoint.new(kp.Time, n))
				end
				if changed then d.Color = ColorSequence.new(out) end
			end
		end
	end

	function Window:SetTransparency(panelT, cardT, fieldT)
		if not self.Gui then return end
		panelT = math.clamp(tonumber(panelT) or self._panelT or 0.38, 0, 0.7)
		cardT = math.clamp(tonumber(cardT) or self._cardT, 0, 0.8)
		fieldT = math.clamp(tonumber(fieldT) or (cardT + 0.05), 0, 0.85)
		local oc, of = self._cardT, self._fieldT
		for _, d in ipairs(self.Main:GetDescendants()) do
			if d:IsA("GuiObject") then
				local bt = d.BackgroundTransparency
				if math.abs(bt - oc) < 0.002 then
					d.BackgroundTransparency = cardT
				elseif math.abs(bt - of) < 0.002 then
					d.BackgroundTransparency = fieldT
				end
			end
		end
		self._panelT, self._cardT, self._fieldT = panelT, cardT, fieldT
		self.Main.BackgroundTransparency = panelT
	end

	function Library:SetTheme(name)
		local p = Library.Presets[name]
		if not p then return false end
		local old = {}
		for k, v in pairs(Theme) do old[k] = v end
		for k, v in pairs(p) do
			if type(v) == "string" then Theme[k] = Color3.fromHex(v) end
		end
		Library.ThemeName = name
		Library.PanelTransparency, Library.CardTransparency, Library.FieldTransparency = p.PanelT, p.CardT, p.FieldT
		for _, w in ipairs(Library.Windows) do
			w:_retheme(old)
			w:SetTransparency(p.PanelT, p.CardT, p.FieldT)
		end
		return true
	end

	function Library:SetAccent(color)
		if typeof(color) ~= "Color3" then return false end
		local old = {}
		for k, v in pairs(Theme) do old[k] = v end
		Theme.Blue = color
		Theme.Cyan = color:Lerp(Color3.new(1, 1, 1), 0.35)
		for _, w in ipairs(Library.Windows) do w:_retheme(old) end
		return true
	end

