function Library:CheckCompatibility()
        RefreshExecutorAPIs()
        local function available(fn)
                return typeof(fn) == "function"
        end
        local executorName = "Tidak diketahui"
        local identifyFn = FirstFunction(identifyexecutor, getexecutorname)
        if identifyFn then
                local ok, name = pcall(identifyFn)
                if ok and name then executorName = tostring(name) end
        end

        local capabilities = {
                UI = typeof(Instance) == "table" and available(Instance.new) and game ~= nil,
                TouchInput = UserInputService ~= nil and UserInputService.TouchEnabled == true,
                KeyboardInput = UserInputService ~= nil and UserInputService.KeyboardEnabled == true,
                MouseInput = UserInputService ~= nil and UserInputService.MouseEnabled == true,
                HttpRequest = available(requestFn),
                Clipboard = available(clipboardFn),
                CustomAsset = available(customAssetFn),
                ReadFile = available(readfile),
                WriteFile = available(writefile),
                IsFile = available(isfile),
                MakeFolder = available(makefolder),
                IsFolder = available(isfolder),
                DeleteFile = available(delfile),
                ListFiles = available(listfiles),
                IdentifyExecutor = identifyFn ~= nil,
                PlayerGui = LocalPlayer ~= nil and LocalPlayer:FindFirstChildOfClass("PlayerGui") ~= nil,
        }

        local supported, unsupported = {}, {}
        for name, ok in pairs(capabilities) do
                if ok then
                        table.insert(supported, name)
                else
                        table.insert(unsupported, name)
                end
        end
        table.sort(supported)
        table.sort(unsupported)

        return {
                Executor = executorName,
                Version = self.Version,
                Capabilities = capabilities,
                Supported = supported,
                Unsupported = unsupported,
                Note = "Pemeriksaan pasif. Keberadaan API tidak menjamin API berfungsi atau kompatibel penuh.",
        }
end

