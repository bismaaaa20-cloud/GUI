	local function build(fn, parent, size, color)
		local f = New("Frame", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Parent = parent })
		local th = 0.1
		local px = math.max(1, size * th)		local function L(x1, y1, x2, y2)
			local dx, dy = x2 - x1, y2 - y1
			New("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale((x1 + x2) / 2, (y1 + y2) / 2),
				Size = UDim2.fromScale(math.sqrt(dx * dx + dy * dy) + th * 0.6, th), BackgroundColor3 = color,
				BorderSizePixel = 0, Rotation = math.deg(math.atan2(dy, dx)), Parent = f,
			}, { Corner(0, 0.5) })
		end
		local function P(...)
			local p = { ... }
			for i = 1, #p - 3, 2 do L(p[i], p[i + 1], p[i + 2], p[i + 3]) end
		end
		local function O(x, y, w, h, r)
			New("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y), Size = UDim2.fromScale(w, h),
				BackgroundTransparency = 1, BorderSizePixel = 0, Parent = f,
			}, { Corner(0, r), Stroke(color, px, 0) })
		end
		local c = {
			L = L, P = P,
			C = function(x, y, w, h) O(x, y, w, h, 0.5) end,
			R = function(x, y, w, h) O(x, y, w, h, 0.15) end,
