	function Window:_flushUI()
		if not self._uiDirty or not canFS() then return end
		self._uiDirty = false
		pcall(function()
			local dir = self._folder:match("^(.*)/[^/]*$")
			if dir and typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(dir) then makefolder(dir) end
