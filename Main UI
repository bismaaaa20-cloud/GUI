function Library:CreateWindow(opts)
	opts = opts or {}

	-- Kait sistem key: kalau KeyCheck diberikan dan tidak mengembalikan true, window tidak dibuat.
	if typeof(opts.KeyCheck) == "function" then
		local ok, valid = pcall(opts.KeyCheck)
		if not ok or valid ~= true then
			warn("[MouseUI] KeyCheck gagal, window tidak dibuat.")
			return nil
		end
	end

	local self = setmetatable({}, Window)
	self.Title = tostring(opts.Title or "MouseUI")
	self.Flags = {}
	self._conns = {}
	self._tabs = {}
	self._setters = {}
	self._activeTab = nil
	self._visible = true
	self._folder = "MouseUI/" .. self.Title:gsub("[^%w_%-]", "_")
	if opts.ConfigFolder then
		self._folder = tostring(opts.ConfigFolder)
	end

	local parent = GetGuiParent()
	local guiName = "MouseUI_" .. self.Title
	local old = parent:FindFirstChild(guiName)
	if old then
		old:Destroy()
	end

	local gui = New("ScreenGui", {
		Name = guiName,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		IgnoreGuiInset = true,
	})
	if typeof(syn) == "table" and syn.protect_gui then
		pcall(syn.protect_gui, gui)
	end
	gui.Parent = parent
	self.Gui = gui

	--// Main frame
	local main = New("Frame", {
		Name = "Main",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(560, 320),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = gui,
	}, {
		Corner(8),
		New("UIStroke", { Color = Theme.Stroke, Thickness = 1 }),
	})
	self.Main = main

	self._scale = New("UIScale", { Scale = 1, Parent = main })
	self:SetScale(opts.Scale or "Medium")

	--// Top bar
	local top = New("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		Parent = main,
	})

	local titleText = self.Title
	if opts.SubTitle then
		titleText = titleText .. " : " .. tostring(opts.SubTitle)
	end
	if opts.Author then
		titleText = titleText .. ' <font size="11" color="rgb(150,150,162)">by ' .. tostring(opts.Author) .. "</font>"
	end

	New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -110, 1, 0),
		Font = FONT.Medium,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		RichText = true,
		Text = titleText,
		Parent = top,
	})

	local function topButton(text, xOffset, callback)
		local b = New("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, xOffset, 0.5, 0),
			Size = UDim2.fromOffset(30, 30),
			BackgroundTransparency = 1,
			Font = FONT.Bold,
			TextSize = 16,
			TextColor3 = Theme.SubText,
			Text = text,
			AutoButtonColor = false,
			Parent = top,
		})
		b.MouseButton1Click:Connect(callback)
		return b
	end
	topButton("X", -8, function()
		self:Destroy()
	end)
	topButton("—", -40, function()
		self:Toggle(false)
	end)

	--// Sidebar
	local sidebar = New("Frame", {
		Name = "Sidebar",
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(0, 150, 1, -40),
		BackgroundColor3 = Theme.Sidebar,
		BorderSizePixel = 0,
		Parent = main,
	})

	self._searchBox = New("TextBox", {
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 0, 28),
		BackgroundColor3 = Theme.Element,
		PlaceholderText = "Search...",
		PlaceholderColor3 = Theme.SubText,
		Text = "",
		ClearTextOnFocus = false,
		Font = FONT.Regular,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = sidebar,
	}, { Corner(6), Pad(8, 0, 8, 0) })

	self._tabList = New("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 1, -48),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = sidebar,
	}, {
		New("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
		Pad(8, 0, 8, 4),
	})

	--// Content
	self._content = New("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(158, 46),
		Size = UDim2.new(1, -166, 1, -54),
		BackgroundTransparency = 1,
		Parent = main,
	})

	self._searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		if self._activeTab then
			self._activeTab:_applySearch(self._searchBox.Text)
		end
	end)

	--// Notification holder
	self._notifyHolder = New("Frame", {
		Name = "Notifications",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.new(0, 250, 1, -24),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	self._notifyOrder = 0

	--// Floating icon (buka/tutup UI)
	local iconBtn = New("TextButton", {
		Name = "ToggleIcon",
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.new(0.5, -23, 0, 14),
		BackgroundColor3 = Theme.Background,
		AutoButtonColor = false,
		Text = opts.Icon and "" or "M",
		Font = FONT.Bold,
		TextSize = 20,
		TextColor3 = Theme.Text,
		Parent = gui,
	}, {
		Corner(0, 1),
		New("UIStroke", { Color = Theme.Accent, Thickness = 2 }),
	})
	if opts.Icon then
		New("ImageLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Image = ToAsset(opts.Icon),
			Parent = iconBtn,
		}, { Corner(0, 1) })
	end

	local function track(conn)
		return self:_track(conn)
	end
	local function getScale()
		return self._scale.Scale
	end
	MakeDraggable(top, main, track, nil, getScale)
	MakeDraggable(iconBtn, iconBtn, track, function()
		self:Toggle()
	end, nil)

	--// Tombol keyboard (PC)
	local toggleKey = opts.ToggleKey or Enum.KeyCode.RightControl
	track(UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == toggleKey then
			self:Toggle()
		end
	end))

	table.insert(Library.Windows, self)
	return self
end

function Window:_track(conn)
	table.insert(self._conns, conn)
	return conn
end

function Window:_flag(flag, value)
	if flag then
		self.Flags[flag] = value
	end
end

function Window:SetScale(v)
	local s = type(v) == "number" and v or SCALES[v]
	if s then
		self._scale.Scale = math.clamp(s, 0.5, 2)
	end
end

function Window:Toggle(state)
	if state == nil then
		state = not self._visible
	end
	self._visible = state
	self.Main.Visible = state
end

function Window:Destroy()
	for _, conn in ipairs(self._conns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	self._conns = {}
	if self.Gui then
		self.Gui:Destroy()
		self.Gui = nil
	end
	for i, w in ipairs(Library.Windows) do
		if w == self then
			table.remove(Library.Windows, i)
			break
		end
	end
end

function Window:Notify(o)
	o = o or {}
	self._notifyOrder += 1
	local card = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		LayoutOrder = self._notifyOrder,
		Parent = self._notifyHolder,
	}, {
		Corner(8),
		New("UIStroke", { Color = Theme.Accent, Thickness = 1 }),
		Pad(10, 8, 10, 8),
		New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = FONT.Bold,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Text = tostring(o.Title or "Notifikasi"),
		LayoutOrder = 1,
		Parent = card,
	})
	if o.Content then
		New("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Font = FONT.Regular,
			TextSize = 12,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			Text = tostring(o.Content),
			LayoutOrder = 2,
			Parent = card,
		})
	end
	task.delay(o.Duration or 4, function()
		if card and card.Parent then
			card:Destroy()
		end
	end)
end

function Window:SaveConfig(name)
	if typeof(writefile) ~= "function" then
		return false, "executor tidak mendukung writefile"
	end
	local ok, err = pcall(function()
		if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(self._folder) then
			makefolder(self._folder)
		end
		writefile(self._folder .. "/" .. tostring(name or "default") .. ".json", HttpService:JSONEncode(self.Flags))
	end)
	return ok, err
end

function Window:LoadConfig(name)
	if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then
		return false, "executor tidak mendukung readfile/isfile"
	end
	local path = self._folder .. "/" .. tostring(name or "default") .. ".json"
	if not isfile(path) then
		return false, "file config tidak ditemukan"
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then
		return false, "file config rusak"
	end
	for flag, value in pairs(data) do
		local setter = self._setters[flag]
		if setter then
			pcall(setter, value)
		end
	end
	return true
end

function Window:_select(tab)
	for _, t in ipairs(self._tabs) do
		local active = (t == tab)
		t.Page.Visible = active
		t.Button.BackgroundTransparency = active and 0 or 1
		t._indicator.Visible = active
		t._label.TextColor3 = active and Theme.Text or Theme.SubText
		if t._icon then
			t._icon.ImageColor3 = active and Theme.Accent or Theme.SubText
		end
	end
	self._activeTab = tab
	tab:_applySearch(self._searchBox.Text)
end

function Window:AddTab(opts)
	if type(opts) == "string" then
		opts = { Name = opts }
	end
	opts = opts or {}

	local tab = setmetatable({}, Tab)
	tab.Window = self
	tab.Name = tostring(opts.Name or "Tab")
	tab._items = {}
	tab._sections = {}
	tab._currentSection = nil
	tab._order = 1

	tab.Button = New("TextButton", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = Theme.Element,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = #self._tabs + 1,
		Parent = self._tabList,
	}, { Corner(6) })

	tab._indicator = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(3, 18),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Visible = false,
		Parent = tab.Button,
	}, { Corner(2) })

	if opts.Icon then
		tab._icon = New("ImageLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 8),
			Size = UDim2.fromOffset(18, 18),
			Image = ToAsset(opts.Icon),
			ImageColor3 = Theme.SubText,
			Parent = tab.Button,
		})
	end

	tab._label = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(opts.Icon and 38 or 14, 0),
		Size = UDim2.new(1, opts.Icon and -42 or -18, 1, 0),
		Font = FONT.Medium,
		TextSize = 13,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = tab.Name,
		Parent = tab.Button,
	})

	tab.Page = New("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Parent = self._content,
	}, {
		New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		Pad(0, 0, 6, 8),
	})

	tab.Button.MouseButton1Click:Connect(function()
		self:_select(tab)
	end)

	table.insert(self._tabs, tab)
	if #self._tabs == 1 then
		self:_select(tab)
	end
	return tab
end

--// ===== Tab internals =====

function Tab:_row(height, searchText)
	local row = New("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		LayoutOrder = self._order,
		Parent = self.Page,
	}, { Corner(6) })
	self._order += 1
	table.insert(self._items, {
		Frame = row,
		Text = string.lower(tostring(searchText or "")),
		Section = self._currentSection,
	})
	return row
end

function Tab:_title(row, name, desc, rightInset)
	New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, desc and 6 or 0),
		Size = desc and UDim2.new(1, rightInset, 0, 18) or UDim2.new(1, rightInset, 1, 0),
		Font = FONT.Medium,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = tostring(name),
		Parent = row,
	})
	if desc then
		New("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 25),
			Size = UDim2.new(1, rightInset, 0, 16),
			Font = FONT.Regular,
			TextSize = 11,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = tostring(desc),
			Parent = row,
		})
	end
end

function Tab:_applySearch(query)
	local q = string.lower(query or "")
	local visibleSections = {}
	for _, item in ipairs(self._items) do
		local vis = q == ""
			or string.find(item.Text, q, 1, true) ~= nil
			or (item.Section ~= nil and string.find(item.Section.Text, q, 1, true) ~= nil)
		item.Frame.Visible = vis
		if vis and item.Section then
			visibleSections[item.Section] = true
		end
	end
	for _, sec in ipairs(self._sections) do
		sec.Frame.Visible = q == "" or visibleSections[sec] == true
	end
end

--// ===== Elements =====

function Tab:AddSection(name)
	local lbl = New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 1,
		Font = FONT.Bold,
		TextSize = 16,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = tostring(name),
		LayoutOrder = self._order,
		Parent = self.Page,
	}, { Pad(4, 0, 0, 0) })
	self._order += 1
	local sec = { Frame = lbl, Text = string.lower(tostring(name)) }
	table.insert(self._sections, sec)
	self._currentSection = sec
end

function Tab:AddLabel(text, height)
	local row = self:_row(height or 32, text)
	local lbl = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Font = FONT.Regular,
		TextSize = 12,
		TextWrapped = true,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = tostring(text),
		Parent = row,
	})
	local obj = {}
	function obj:Set(t)
		lbl.Text = tostring(t)
	end
	return obj
end

function Tab:AddButton(o)
	o = o or {}
	local hasDesc = o.Desc ~= nil and o.Desc ~= ""
	local row = self:_row(hasDesc and 48 or 38, tostring(o.Name or "") .. " " .. tostring(o.Desc or ""))
	self:_title(row, o.Name or "Button", hasDesc and o.Desc or nil, -40)
	New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(14, 20),
		BackgroundTransparency = 1,
		Font = FONT.Bold,
		TextSize = 16,
		TextColor3 = Theme.SubText,
		Text = ">",
		Parent = row,
	})
	local btn = New("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})
	btn.MouseButton1Click:Connect(function()
		row.BackgroundColor3 = Theme.ElementHover
		Tween(row, 0.25, { BackgroundColor3 = Theme.Element })
		SafeCall(o.Callback)
	end)
	local obj = {}
	function obj:Fire()
		SafeCall(o.Callback)
	end
	return obj
end

function Tab:AddToggle(o)
	o = o or {}
	local window = self.Window
	local hasDesc = o.Desc ~= nil and o.Desc ~= ""
	local row = self:_row(hasDesc and 48 or 38, tostring(o.Name or "") .. " " .. tostring(o.Desc or ""))
	self:_title(row, o.Name or "Toggle", hasDesc and o.Desc or nil, -64)

	local switch = New("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(38, 20),
		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
		Parent = row,
	}, { Corner(0, 1) })
	local knob = New("Frame", {
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		Parent = switch,
	}, { Corner(0, 1) })
	local btn = New("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})

	local value = o.Default == true
	local function render(animate)
		local pos = value and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3)
		local col = value and Theme.Accent or Theme.Stroke
		if animate then
			Tween(knob, 0.12, { Position = pos })
			Tween(switch, 0.12, { BackgroundColor3 = col })
		else
			knob.Position = pos
			switch.BackgroundColor3 = col
		end
	end

	local obj = {}
	function obj:Set(v, silent)
		value = v and true or false
		render(true)
		window:_flag(o.Flag, value)
		if not silent then
			SafeCall(o.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	btn.MouseButton1Click:Connect(function()
		obj:Set(not value)
	end)

	render(false)
	window:_flag(o.Flag, value)
	if o.Flag then
		window._setters[o.Flag] = function(v)
			obj:Set(v)
		end
	end
	if value then
		task.defer(SafeCall, o.Callback, value)
	end
	return obj
end

function Tab:AddSlider(o)
	o = o or {}
	local window = self.Window
	local min, max = o.Min or 0, o.Max or 100
	local inc = o.Increment or 1
	local suffix = o.Suffix or ""
	local span = math.max(max - min, 1e-9)

	local function snap(v)
		v = math.floor(v / inc + 0.5) * inc
		v = math.clamp(v, min, max)
		return tonumber(string.format("%.4f", v))
	end

	local value = snap(o.Default or min)
	local row = self:_row(54, o.Name or "")

	New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -110, 0, 18),
		Font = FONT.Medium,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = tostring(o.Name or "Slider"),
		Parent = row,
	})
	local valLbl = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 6),
		Size = UDim2.fromOffset(90, 18),
		BackgroundTransparency = 1,
		Font = FONT.Medium,
		TextSize = 12,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Parent = row,
	})
	local bar = New("Frame", {
		Position = UDim2.fromOffset(12, 36),
		Size = UDim2.new(1, -24, 0, 8),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		Parent = row,
	}, { Corner(0, 1) })
	local fill = New("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = bar,
	}, { Corner(0, 1) })
	local hit = New("TextButton", {
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})

	local obj = {}
	function obj:Set(v, silent)
		value = snap(tonumber(v) or min)
		fill.Size = UDim2.fromScale((value - min) / span, 1)
		valLbl.Text = tostring(value) .. suffix
		window:_flag(o.Flag, value)
		if not silent then
			SafeCall(o.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	local dragging = false
	local page = self.Page
	local function fromX(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local new = snap(min + (max - min) * rel)
		if new ~= value then
			obj:Set(new)
		end
	end
	hit.InputBegan:Connect(function(input)
		if IsPress(input) then
			dragging = true
			page.ScrollingEnabled = false
			fromX(input.Position.X)
		end
	end)
	window:_track(UserInputService.InputChanged:Connect(function(input)
		if dragging and IsMove(input) then
			fromX(input.Position.X)
		end
	end))
	window:_track(UserInputService.InputEnded:Connect(function(input)
		if dragging and IsPress(input) then
			dragging = false
			page.ScrollingEnabled = true
		end
	end))

	obj:Set(value, true)
	if o.Flag then
		window._setters[o.Flag] = function(v)
			obj:Set(v)
		end
	end
	task.defer(SafeCall, o.Callback, value)
	return obj
end

function Tab:AddInput(o)
	o = o or {}
	local window = self.Window
	local row = self:_row(40, o.Name or "")
	self:_title(row, o.Name or "Input", nil, -170)

	local box = New("TextBox", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 7),
		Size = UDim2.fromOffset(150, 26),
		BackgroundColor3 = Theme.Background,
		Font = FONT.Regular,
		TextSize = 12,
		TextColor3 = Theme.Text,
		PlaceholderText = tostring(o.Placeholder or "..."),
		PlaceholderColor3 = Theme.SubText,
		Text = "",
		ClearTextOnFocus = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	}, { Corner(5), Pad(8, 0, 8, 0) })

	local value = ""
	local obj = {}
	function obj:Set(v, silent)
		local text = tostring(v == nil and "" or v)
		if o.Numeric then
			local n = tonumber(text)
			if n == nil then
				box.Text = tostring(value)
				return
			end
			value = n
			box.Text = tostring(n)
		else
			value = text
			box.Text = text
		end
		window:_flag(o.Flag, value)
		if not silent then
			SafeCall(o.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	box.FocusLost:Connect(function()
		obj:Set(box.Text)
	end)

	if o.Default ~= nil then
		obj:Set(o.Default, true)
	end
	if o.Flag then
		window._setters[o.Flag] = function(v)
			obj:Set(v)
		end
	end
	return obj
end

function Tab:AddDropdown(o)
	o = o or {}
	local window = self.Window
	local multi = o.Multi == true
	local OPT_H, MAX_VISIBLE = 28, 5

	local options = {}
	for _, v in ipairs(o.Options or {}) do
		table.insert(options, tostring(v))
	end
	local single = nil
	local set = {}
	local open = false
	local optButtons = {}

	local row = self:_row(40, o.Name or "")
	row.ClipsDescendants = true
	self:_title(row, o.Name or "Dropdown", nil, -176)

	local valueBox = New("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 7),
		Size = UDim2.fromOffset(156, 26),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		Parent = row,
	}, { Corner(5) })
	local valueLbl = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.new(1, -26, 1, 0),
		Font = FONT.Medium,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "None",
		Parent = valueBox,
	})
	local arrow = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -6, 0, 0),
		Size = UDim2.fromOffset(14, 26),
		BackgroundTransparency = 1,
		Font = FONT.Bold,
		TextSize = 11,
		TextColor3 = Theme.SubText,
		Text = "v",
		Parent = valueBox,
	})
	local list = New("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 44),
		Size = UDim2.new(1, -16, 0, 0),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = row,
	}, {
		Corner(5),
		New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
		Pad(2, 2, 2, 2),
	})
	local header = New("TextButton", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})

	local function currentList()
		local out = {}
		for _, opt in ipairs(options) do
			if set[opt] then
				table.insert(out, opt)
			end
		end
		return out
	end
	local function currentValue()
		if multi then
			return currentList()
		end
		return single
	end
	local function updateText()
		if multi then
			local l = currentList()
			valueLbl.Text = #l > 0 and table.concat(l, ", ") or "None"
		else
			valueLbl.Text = single or "None"
		end
	end
	local function paintOptions()
		for opt, b in pairs(optButtons) do
			local selected
			if multi then
				selected = set[opt] == true
			else
				selected = single == opt
			end
			b.BackgroundColor3 = selected and Theme.Accent or Theme.Element
			b.TextColor3 = selected and Color3.new(1, 1, 1) or Theme.Text
		end
	end
	local function listHeight()
		return math.min(#options, MAX_VISIBLE) * (OPT_H + 2) + 4
	end
	local function resize()
		local h = open and (44 + listHeight() + 8) or 40
		list.Visible = open
		list.Size = UDim2.new(1, -16, 0, listHeight())
		arrow.Text = open and "^" or "v"
		Tween(row, 0.15, { Size = UDim2.new(1, 0, 0, h) })
	end

	local obj = {}
	function obj:Get()
		return currentValue()
	end
	function obj:Set(v, silent)
		set = {}
		single = nil
		if multi then
			for _, k in ipairs(type(v) == "table" and v or {}) do
				set[tostring(k)] = true
			end
		else
			single = v ~= nil and tostring(v) or nil
		end
		updateText()
		paintOptions()
		window:_flag(o.Flag, currentValue())
		if not silent then
			SafeCall(o.Callback, currentValue())
		end
	end

	local function build()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") then
				c:Destroy()
			end
		end
		optButtons = {}
		for i, opt in ipairs(options) do
			local b = New("TextButton", {
				Size = UDim2.new(1, 0, 0, OPT_H),
				BackgroundColor3 = Theme.Element,
				AutoButtonColor = false,
				Font = FONT.Regular,
				TextSize = 12,
				Text = opt,
				TextColor3 = Theme.Text,
				LayoutOrder = i,
				Parent = list,
			}, { Corner(4) })
			optButtons[opt] = b
			b.MouseButton1Click:Connect(function()
				if multi then
					set[opt] = (not set[opt]) or nil
				else
					single = opt
					open = false
					resize()
				end
				updateText()
				paintOptions()
				window:_flag(o.Flag, currentValue())
				SafeCall(o.Callback, currentValue())
			end)
		end
		paintOptions()
	end

	function obj:Refresh(newOptions, keep)
		options = {}
		for _, v in ipairs(newOptions or {}) do
			table.insert(options, tostring(v))
		end
		if keep then
			local ns = {}
			for k in pairs(set) do
				if table.find(options, k) then
					ns[k] = true
				end
			end
			set = ns
			if single and not table.find(options, single) then
				single = nil
			end
		else
			set = {}
			single = nil
		end
		build()
		updateText()
		if open then
			resize()
		end
	end

	header.MouseButton1Click:Connect(function()
		open = not open
		resize()
	end)

	build()
	if o.Default ~= nil then
		obj:Set(o.Default, true)
		task.defer(SafeCall, o.Callback, currentValue())
	end
	if o.Flag then
		window._setters[o.Flag] = function(v)
			obj:Set(v)
		end
	end
	return obj
end

return Library
