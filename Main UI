-- API executor opsional; nama implementasinya berbeda-beda.
local function FirstFunction(...)
	for i = 1, select("#", ...) do
		local fn = select(i, ...)
		if typeof(fn) == "function" then return fn end
	end
	return nil
end

local customAssetFn, clipboardFn, requestFn
local function RefreshExecutorAPIs()
	customAssetFn = FirstFunction(getcustomasset, getsynasset)
	clipboardFn = FirstFunction(setclipboard, toclipboard)
	requestFn = FirstFunction(request, http_request, syn and syn.request, http and http.request, fluxus and fluxus.request, electron and electron.request)
	return requestFn, clipboardFn, customAssetFn
end
RefreshExecutorAPIs()
local function SetClipboard(value)
	RefreshExecutorAPIs()
	if not clipboardFn then return false end
	local ok = pcall(clipboardFn, tostring(value or ""))
	return ok
end

