			}, { Corner(0, 1) })
		end
		local btn = New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = row })
		Pressable(btn, row, Theme.Card, Theme.Hover)
		local value = o.Default == true
		local function render(animate)
			if checkbox then
				local t = value and 0 or 1
				if animate then Tween(knob, 0.14, { BackgroundTransparency = t }) else knob.BackgroundTransparency = t end
				return
			end
			local pos = value and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3)
			local col = value and Theme.Blue or Theme.Off
			if animate then
				Tween(knob, 0.18, { Position = pos }, Enum.EasingStyle.Back)
				Tween(switch, 0.16, { BackgroundColor3 = col })
			else
				knob.Position = pos
				switch.BackgroundColor3 = col
			end
		end
		local obj = {}
		function obj:Set(v, silent)
			value = v and true or false
			render(true)
			window:_flag(o.Flag, value)
			if not silent then SafeCall(o.Callback, value) end
		end
		function obj:Get() return value end
		btn.MouseButton1Click:Connect(function() obj:Set(not value) end)
		render(false)
		window:_flag(o.Flag, value)
		if o.Flag then
			window:_registerFlag(o.Flag, function(v) obj:Set(v) end, function(v)
				if type(v) ~= "boolean" then return false, "harus boolean" end
				return true, v
			end)
		end
		if (value and o.FireOnInit ~= false) or o.FireOnInit == true then
			task.defer(SafeCall, o.Callback, value)
		end
		return obj
	end

