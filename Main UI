			PlaceholderText = "#RRGGBB", PlaceholderColor3 = Theme.SubText, ClearTextOnFocus = false, Text = "", Parent = row,
		}, { Corner(9), Pad(12, 0, 12, 0), Stroke(Theme.Glow, 1, 0.65) })

		local obj = {}
		local function apply(silent)
			local c = Color3.fromHSV(h, s, v)
			sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			svCur.Position = UDim2.fromScale(s, 1 - v)
			hueCur.Position = UDim2.fromScale(0.5, h)
			chip.BackgroundColor3 = c
			if not box:IsFocused() then box.Text = "#" .. hex(c) end
			window:_flag(o.Flag, hex(c))
			if not silent then SafeCall(o.Callback, c) end
		end
		function obj:Get() return Color3.fromHSV(h, s, v) end
		function obj:Set(c, silent)
			if typeof(c) ~= "Color3" then return end
			h, s, v = c:ToHSV()
			apply(silent)
		end

		local function py(pos) return pos.Y + GuiService:GetGuiInset().Y end
		local function fromSV(pos)
			local ap, as = sv.AbsolutePosition, sv.AbsoluteSize
			s = math.clamp((pos.X - ap.X) / math.max(as.X, 1), 0, 1)
			v = 1 - math.clamp((py(pos) - ap.Y) / math.max(as.Y, 1), 0, 1)
			apply(false)
		end
		local function fromHue(pos)
			local ap, as = hue.AbsolutePosition, hue.AbsoluteSize
			h = math.clamp((py(pos) - ap.Y) / math.max(as.Y, 1), 0, 0.999)
			apply(false)
		end
		local dragging, wasScrolling = nil, true
		local function startDrag(kind, input)
			dragging, wasScrolling = kind, page.ScrollingEnabled
			page.ScrollingEnabled = false
			if kind == "sv" then fromSV(input.Position) else fromHue(input.Position) end
		end
		svHit.InputBegan:Connect(function(i) if IsPress(i) then startDrag("sv", i) end end)
		hueHit.InputBegan:Connect(function(i) if IsPress(i) then startDrag("hue", i) end end)
		window:_track(UserInputService.InputChanged:Connect(function(i)
			if dragging and IsMove(i) then
				if dragging == "sv" then fromSV(i.Position) else fromHue(i.Position) end
			end
		end))
		window:_track(UserInputService.InputEnded:Connect(function(i)
			if dragging and IsPress(i) then
				dragging = nil
				page.ScrollingEnabled = wasScrolling
			end
		end))
		local open = false
		head.MouseButton1Click:Connect(function()
			open = not open
			Tween(row, 0.16, { Size = UDim2.new(1, 0, 0, open and OPEN or CLOSED) })
		end)
		box.FocusLost:Connect(function()
			local t = box.Text:gsub("[#%s]", "")
			if #t == 6 and tonumber(t, 16) then obj:Set(Color3.fromHex(t)) else apply(true) end
		end)
		if o.Flag then
			window:_registerFlag(o.Flag, function(x) obj:Set(Color3.fromHex(x)) end, function(x)
				if type(x) ~= "string" then return false, "harus hex" end
				local t = x:gsub("#", "")
				if #t ~= 6 or not tonumber(t, 16) then return false, "hex tidak valid" end
				return true, t
			end)
		end
		obj:Set(typeof(o.Default) == "Color3" and o.Default or Color3.new(1, 1, 1), true)
		if ShouldFire(o) then task.defer(SafeCall, o.Callback, obj:Get()) end
		return obj
	end

