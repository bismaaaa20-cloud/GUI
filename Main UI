function Tab:AddSlider(o)
	o = o or {}
	local window = self.Window
	local min, max = o.Min or 0, o.Max or 100
	local inc = o.Increment or 1
	local suffix = o.Suffix or ""
	local span = math.max(max - min, 1e-9)

	local function snap(v)
		v = math.floor(v / inc + 0.5) * inc
		v = math.clamp(v, min, max)
		return tonumber(string.format("%.4f", v))
	end

	local value = snap(o.Default or min)
	local row = self:_row(64, o.Name or "")

	New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 9),
		Size = UDim2.new(1, -120, 0, 20),
		Font = FONT.Semi,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = tostring(o.Name or "Slider"),
		Parent = row,
	})
	local valLbl = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 9),
		Size = UDim2.fromOffset(100, 20),
		BackgroundTransparency = 1,
		Font = FONT.Bold,
		TextSize = 13,
		TextColor3 = Theme.Cyan,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Parent = row,
	})
	local track = New("Frame", {
		Position = UDim2.fromOffset(14, 44),
		Size = UDim2.new(1, -28, 0, 6),
		BackgroundColor3 = Theme.Secondary,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Parent = row,
	}, { Corner(0, 1) })
	local fill = New("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Blue,
		BorderSizePixel = 0,
		Parent = track,
	}, { Corner(0, 1) })
	local thumb = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = Theme.Soft,
		BorderSizePixel = 0,
		Parent = track,
	}, { Corner(0, 1), Stroke(Theme.Blue, 2, 0) })
	-- Area sentuh luas (tinggi 40) supaya mudah digeser di HP
	local hit = New("TextButton", {
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})

	local obj = {}
	function obj:Set(v, silent)
		value = snap(tonumber(v) or min)
		local rel = (value - min) / span
		fill.Size = UDim2.fromScale(rel, 1)
		thumb.Position = UDim2.fromScale(rel, 0.5)
		valLbl.Text = tostring(value) .. suffix
		window:_flag(o.Flag, value)
		if not silent then
			SafeCall(o.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	local dragging = false
	local page = self.Page
	local function fromX(x)
		local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local new = snap(min + (max - min) * rel)
		if new ~= value then
			obj:Set(new)
		end
	end
	local function setThumb(big)
		Tween(thumb, 0.12, { Size = big and UDim2.fromOffset(22, 22) or UDim2.fromOffset(18, 18) })
	end
	hit.InputBegan:Connect(function(input)
		if IsPress(input) then
			dragging = true
			page.ScrollingEnabled = false
			setThumb(true)
			fromX(input.Position.X)
		end
	end)
	window:_track(UserInputService.InputChanged:Connect(function(input)
		if dragging and IsMove(input) then
			fromX(input.Position.X)
		end
	end))
	window:_track(UserInputService.InputEnded:Connect(function(input)
		if dragging and IsPress(input) then
			dragging = false
			page.ScrollingEnabled = true
			setThumb(false)
		end
	end))

	obj:Set(value, true)
	if o.Flag then
		window._setters[o.Flag] = function(v)
			obj:Set(v)
		end
	end
	task.defer(SafeCall, o.Callback, value)
	return obj
end

